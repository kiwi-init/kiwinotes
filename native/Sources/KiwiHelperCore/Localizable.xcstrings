          }
        }
      }
    },
    "overlay.finish": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish dictation"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminar ditado"
          }
        }
      }
    },
    "permission.why.accessibility": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To paste the text into the app you're typing in, and so Kiwi's shortcuts take priority over other apps' shortcuts."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para colar o texto no app em que você está digitando, e para que os atalhos do Kiwi tenham prioridade sobre os dos outros apps."
          }
        }
      }
    },
    "permission.why.inputMonitoring": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To notice Kiwi's shortcuts (dictation, meetings, notes) in any app. Kiwi Notes doesn't read what you type."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para perceber os atalhos do Kiwi (o ditado, as reuniões, as notas) em qualquer app. O Kiwi Notes não lê o que você digita."
          }
        }
      }
    },
    "permission.why.microphone": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To hear your dictation, or your voice in the meetings you ask to record. The audio never leaves the Mac."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ouvir o ditado ou sua voz nas reuniões que você pedir para gravar. O áudio não sai do Mac."
          }
        }
      }
    },
    "permission.why.systemAudio": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To transcribe the meeting's audio on the Mac, only when you ask. The audio is deleted once it's transcribed."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para transcrever o áudio da reunião no Mac, só quando você pede. O áudio é apagado depois de transcrito."
          }
        }
      }
    }
  },
  "version": "1.0"
}
