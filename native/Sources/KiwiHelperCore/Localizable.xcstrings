          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não deu para usar o microfone"
          }
        }
      }
    },
    "overlay.error.micUndetermined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow the microphone and try again"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o microfone e tente de novo"
          }
        }
      }
    },
    "overlay.error.noAudio": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No audio from the microphone"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem áudio do microfone"
          }
        }
      }
    },
