{
  "window": "hub",
  "size": "900x1400",
  "steps": [
    {
      "waitFor": ".kn-tab",
      "name": "o hub abre"
    },
    {
      "click": ".kn-tab:has-text('Configurações')"
    },
    {
      "click": ".kn-prefs-item[data-topic=agent]",
      "name": "o assunto agent da barra lateral (#11966)"
    },
    {
      "waitFor": ".kn-section:has(h2:text-is('Agente'))",
      "name": "a seção Agente"
    },
    {
      "expectText": ".kn-section:has(h2:text-is('Agente'))",
      "text": "instalado e logado",
      "name": "o Claude Code pronto, sem pedir senha"
    },
    {
      "screenshot": "1-desligado.png",
      "selector": ".kn-section:has(h2:text-is('Agente'))"
    },
    {
      "click": ".kn-row:has(.kn-row-label:text-is('Ligar o agente')) [role=switch]",
      "name": "ligar, pela primeira vez"
    },
    {
      "waitFor": ".kn-agent-consent",
      "name": "a tela do ADR 0011 aparece antes de qualquer coisa"
    },
    {
      "expectText": ".kn-agent-consent",
      "text": "O que nunca vai",
      "name": "com o que vai e o que nunca vai"
    },
    {
      "invoke": "agent.status",
      "args": {},
      "name": "ainda desligado, nada baixado"
    },
    {
      "screenshot": "2-aviso.png",
      "selector": ".kn-section:has(h2:text-is('Agente'))"
    },
    {
      "click": ".kn-agent-consent button:has-text('Agora não')",
      "name": "agora não"
    },
    {
      "waitFor": ".kn-agent-consent",
      "state": "detached"
    },
    {
      "expectText": ".kn-row:has(.kn-row-label:text-is('Ligar o agente')) .kn-row-hint",
      "text": "Desligado",
      "name": "continua desligado"
    },
    {
      "click": ".kn-row:has(.kn-row-label:text-is('Ligar o agente')) [role=switch]"
    },
    {
      "click": ".kn-agent-consent button:has-text('Ligar o Claude Code')",
      "name": "aceita e liga"
    },
    {
      "waitFor": ".kn-onb",
      "name": "ligar pela primeira vez abre o onboarding (#11955)"
    },
    {
      "press": "Escape",
      "name": "o Esc fecha o onboarding"
    },
    {
      "waitFor": ".kn-onb",
      "state": "detached"
    },
    {
      "expectText": ".kn-row:has(.kn-row-label:text-is('Adaptador')) .kn-row-hint",
      "text": "Baixando o adaptador",
      "name": "o download começa só depois do Ligar"
    },
    {
      "wait": 1200
    },
    {
      "screenshot": "3-baixando.png",
      "selector": ".kn-section:has(h2:text-is('Agente'))"
    },
    {
      "click": ".kn-row:has(.kn-row-label:text-is('Adaptador')) button:has-text('Cancelar')",
      "name": "cancela o download"
    },
    {
      "expectText": ".kn-row:has(.kn-row-label:text-is('Adaptador')) .kn-row-hint",
      "text": "Download cancelado. Nada foi instalado.",
      "name": "nada fica pela metade"
    },
    {
      "screenshot": "4-cancelado.png",
      "selector": ".kn-section:has(h2:text-is('Agente'))"
    },
    {
      "click": ".kn-row:has(.kn-row-label:text-is('Adaptador')) button:has-text('Tentar de novo')",
      "name": "tenta de novo"
    },
    {
      "expectText": ".kn-row:has(.kn-row-label:text-is('Adaptador')) .kn-row-hint",
      "text": "baixado",
      "timeout": 30000,
      "name": "pronto"
    },
    {
      "waitFor": ".kn-agent-test",
      "name": "o Testar aparece"
    },
    {
      "waitFor": ".kn-row:has(.kn-row-label:text-is('A sua assinatura')) button:text-is('Atualizar'):enabled",
      "timeout": 20000,
      "name": "o medidor já conferiu o uso (o /usage, spec #11084): o agente está livre"
    },
    {
      "expectCount": ".kn-row:has(.kn-row-label:text-is('Cor do Kiwi Cat')) [role=radio]",
      "count": 5,
      "name": "a cor do gato: as 5 paletas do pacote (spec #14963)"
    },
    {
      "expectCount": ".kn-row:has(.kn-row-label:text-is('Cor do Kiwi Cat')) [role=radio][aria-label='Prisma Original'][aria-checked=true]",
      "count": 1,
      "name": "a prisma-original marcada por padrão"
    },
    {
      "click": ".kn-row:has(.kn-row-label:text-is('Cor do Kiwi Cat')) [role=radio][aria-label='Âmbar Noturno']",
      "name": "escolhe a Âmbar Noturno"
    },
    {
      "expectCount": ".kn-row:has(.kn-row-label:text-is('Cor do Kiwi Cat')) [role=radio][aria-label='Âmbar Noturno'][aria-checked=true]",
      "count": 1,
      "name": "ela fica marcada"
    },
    {
      "expectText": ".kn-row:has(.kn-row-label:text-is('Cor do Kiwi Cat')) .kn-row-hint",
      "text": "Âmbar Noturno",
      "name": "a frase diz a paleta"
    },
    {
      "screenshot": "4b-paletas.png",
      "selector": ".kn-row:has(.kn-row-label:text-is('Cor do Kiwi Cat'))"
    },
    {
      "click": ".kn-agent-test button:has-text('Testar')",
      "name": "testa: diga oi"
    },
    {
      "expectText": ".kn-agent-test-text",
      "text": "Você disse",
      "timeout": 20000,
      "name": "a resposta chega ao vivo"
    },
    {
      "screenshot": "5-resposta.png",
      "selector": ".kn-section:has(h2:text-is('Agente'))"
    },
    {
      "fill": ".kn-agent-test-input",
      "text": "/lento"
    },
    {
      "click": ".kn-agent-test button:has-text('Testar')",
      "name": "um pedido longo"
    },
    {
      "expectText": ".kn-agent-test-out",
      "text": "pedaço 2",
      "name": "o texto vai chegando"
    },
    {
      "screenshot": "6-respondendo.png",
      "selector": ".kn-section:has(h2:text-is('Agente'))"
    },
    {
      "click": ".kn-agent-test button:has-text('Cancelar')",
      "name": "cancela no meio"
    },
    {
      "expectText": ".kn-agent-test-status",
      "text": "Cancelado.",
      "name": "termina como cancelado"
    },
    {
      "fill": ".kn-agent-test-input",
      "text": "/limite"
    },
    {
      "click": ".kn-agent-test button:has-text('Testar')"
    },
    {
      "expectText": ".kn-agent-test-error",
      "text": "atingiu o limite de uso",
      "name": "limite atingido, claro"
    },
    {
      "screenshot": "7-limite.png",
      "selector": ".kn-agent-test"
    },
    {
      "fill": ".kn-agent-test-input",
      "text": "/sem-rede"
    },
    {
      "click": ".kn-agent-test button:has-text('Testar')"
    },
    {
      "expectText": ".kn-agent-test-error",
      "text": "Sem conexão com a internet",
      "name": "sem rede, claro"
    },
    {
      "screenshot": "8-sem-rede.png",
      "selector": ".kn-agent-test"
    },
    {
      "fill": ".kn-agent-test-input",
      "text": "/sem-login"
    },
    {
      "click": ".kn-agent-test button:has-text('Testar')"
    },
    {
      "expectText": ".kn-agent-test-error",
      "text": "não está logado",
      "name": "login caído, claro"
    },
    {
      "screenshot": "9-sem-login.png",
      "selector": ".kn-agent-test"
    },
    {
      "fill": ".kn-agent-test-input",
      "text": "de novo, agora sim"
    },
    {
      "click": ".kn-agent-test button:has-text('Testar')",
      "name": "tenta de novo e passa"
    },
    {
      "expectText": ".kn-agent-test-text",
      "text": "agora sim",
      "timeout": 20000
    },
    {
      "select": ".kn-row:has(.kn-row-label:text-is('Modelo')) select",
      "value": "opus",
      "name": "troca o modelo"
    },
    {
      "expectText": ".kn-row:has(.kn-row-label:text-is('Modelo')) .kn-row-hint",
      "text": "gasta mais do seu plano"
    },
    {
      "screenshot": "10-modelo.png",
      "selector": ".kn-section:has(h2:text-is('Agente'))"
    },
    {
      "expectText": ".kn-row:has(.kn-row-label:text-is('Modelo')) .kn-row-hint",
      "text": "Um modelo maior",
      "name": "a linha do Modelo em português (spec #16793)"
    },
    {
      "waitFor": ".kn-row:has(.kn-row-label:text-is('Esforço')) select option[value=max]",
      "state": "attached",
      "timeout": 20000,
      "name": "o Esforço do modelo novo aparece na hora, sem pedido: a tela abre o programa (T25729)"
    },
    {
      "fill": ".kn-agent-test-input",
      "text": "oi no opus"
    },
    {
      "click": ".kn-agent-test button:has-text('Testar')",
      "name": "um pedido no opus"
    },
    {
      "expectText": ".kn-agent-test-text",
      "text": "oi no opus",
      "timeout": 20000
    },
    {
      "waitFor": ".kn-row:has(.kn-row-label:text-is('Esforço')) select",
      "name": "o seletor Esforço, abaixo do Modelo, com as escolhas que o agente dá ao opus"
    },
    {
      "expectCount": ".kn-row:has(.kn-row-label:text-is('Esforço')) select option",
      "count": 6,
      "name": "as seis do opus"
    },
    {
      "expectCount": ".kn-row:has(.kn-row-label:text-is('Esforço')) select option:text-is('Máximo')",
      "count": 1,
      "name": "os nomes em português"
    },
    {
      "select": ".kn-row:has(.kn-row-label:text-is('Esforço')) select",
      "value": "max",
      "name": "o opus no esforço máximo"
    },
    {
      "click": ".kn-row:has(.kn-row-label:text-is('Esforço')) .kn-row-label",
      "name": "rola até o Modelo e o Esforço, para o print"
    },
    {
      "screenshot": "10b-esforco.png"
    },
    {
      "select": ".kn-row:has(.kn-row-label:text-is('Modelo')) select",
      "value": "sonnet",
      "name": "troca para o sonnet"
    },
    {
      "fill": ".kn-agent-test-input",
      "text": "oi no sonnet"
    },
    {
      "click": ".kn-agent-test button:has-text('Testar')"
    },
    {
      "expectText": ".kn-agent-test-text",
      "text": "oi no sonnet",
      "timeout": 20000
    },
    {
      "expectCount": ".kn-row:has(.kn-row-label:text-is('Esforço')) select option",
      "count": 4,
      "name": "o sonnet tem só quatro"
    },
    {
      "select": ".kn-row:has(.kn-row-label:text-is('Esforço')) select",
      "value": "low",
      "name": "o sonnet no esforço baixo"
    },
    {
      "select": ".kn-row:has(.kn-row-label:text-is('Modelo')) select",
      "value": "opus",
      "name": "volta para o opus"
    },
    {
      "expectCount": ".kn-row:has(.kn-row-label:text-is('Esforço')) select option:checked[value='max']",
      "count": 1,
      "name": "o opus continua no máximo: o esforço é de cada modelo"
    },
    {
      "select": ".kn-row:has(.kn-row-label:text-is('Modelo')) select",
      "value": "sonnet"
    },
    {
      "expectCount": ".kn-row:has(.kn-row-label:text-is('Esforço')) select option:checked[value='low']",
      "count": 1,
      "name": "e o sonnet no baixo"
    },
    {
      "select": ".kn-row:has(.kn-row-label:text-is('Modelo')) select",
      "value": "opus-legacy",
      "name": "um modelo sem esforço"
    },
    {
      "fill": ".kn-agent-test-input",
      "text": "oi no legado"
    },
    {
      "click": ".kn-agent-test button:has-text('Testar')"
    },
    {
      "expectText": ".kn-agent-test-text",
      "text": "oi no legado",
      "timeout": 20000
    },
    {
      "expectText": ".kn-row:has(.kn-row-label:text-is('Esforço')) .kn-row-hint",
      "text": "não tem nível de esforço",
      "name": "sem seletor, e a linha diz por quê"
    },
    {
      "expectCount": ".kn-row:has(.kn-row-label:text-is('Esforço')) select",
      "count": 0
    },
    {
      "click": ".kn-row:has(.kn-row-label:text-is('Esforço')) .kn-row-label",
      "name": "rola até o Modelo e o Esforço, para o print"
    },
    {
      "screenshot": "10c-sem-esforco.png"
    },
    {
      "click": ".kn-row:has(.kn-row-label:text-is('Ligar o agente')) [role=switch]",
      "name": "desliga"
    },
    {
      "expectText": ".kn-row:has(.kn-row-label:text-is('Ligar o agente')) .kn-row-hint",
      "text": "Desligado. Nada vai",
      "name": "desligado, na hora"
    },
    {
      "expectCount": ".kn-row:has(.kn-row-label:text-is('Cor do Kiwi Cat')) [role=radio]:disabled",
      "count": 5,
      "name": "com o agente desligado, as amostras ficam desabilitadas"
    },
    {
      "invoke": "agent.status",
      "args": {},
      "name": "o programa fechou"
    },
    {
      "click": ".kn-row:has(.kn-row-label:text-is('Adaptador')) button:has-text('Remover o adaptador')",
      "name": "remove o adaptador"
    },
    {
      "waitFor": ".kn-row:has(.kn-row-label:text-is('Adaptador'))",
      "state": "detached",
      "name": "o download foi apagado"
    },
    {
      "invoke": "agent.status",
      "args": {},
      "name": "adapter missing"
    },
    {
      "screenshot": "11-desligado-removido.png",
      "selector": ".kn-section:has(h2:text-is('Agente'))"
    },
    {
      "click": ".kn-prefs-item[data-topic=privacy]",
      "name": "o assunto privacy da barra lateral (#11966)"
    },
    {
      "screenshot": "12-privacidade.png",
      "selector": ".kn-section:has(h2:text-is('Privacidade'))"
    }
  ]
}
