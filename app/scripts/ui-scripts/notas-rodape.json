{
  "window": "notes",
  "steps": [
    { "invoke": "notes.create", "args": { "title": "Ana", "content": "Cuida do financeiro.\n" } },
    {
      "invoke": "notes.create",
      "args": {
        "title": "Rodapé",
        "content": "# Mudança de escritório\n\nA mudança fica para março[^1], depois da reforma da rede^[A Fio Certo confirmou a data por e-mail.]. O orçamento veio da [[Ana]][^custo].\n\nFalta escolher a empresa[^2].\n\n[^1]: Combinado na reunião de planejamento do dia 2.\n[^custo]: R$ 4.200, sem os móveis. Ver a tabela em **Custos**.\n"
      }
    },
    { "waitFor": ".kn-crumb-bt", "name": "a janela Notas abre" },
    { "press": "Meta+k" },
    { "type": "Rodapé" },
    { "waitFor": ".kn-palette .kn-palette-it:has-text('Rodapé')" },
    { "press": "Enter" },
    { "waitFor": ".kn-note-editor .cm-rendered a[href^='kiwi-footnote-def:']", "name": "as notas de rodapé aparecem desenhadas" },
    { "expectCount": ".kn-note-editor .cm-rendered a[href^='kiwi-footnote:']", "count": 2, "name": "as 2 chamadas com texto: [^1] e [^custo]" },
    { "expectCount": ".kn-note-editor .cm-rendered a[href^='kiwi-footnote-inline:']", "count": 1, "name": "a nota em linha ^[…]" },
    { "expectCount": ".kn-note-editor .cm-rendered a[href^='kiwi-footnote-missing:']", "count": 1, "name": "a [^2] ainda sem texto, apagada" },
    { "expectText": ".kn-note-editor .cm-rendered a[href='kiwi-footnote:custo']", "text": "³", "name": "o número segue a ordem do texto: a nota em linha é a 2ª" },
    { "hover": ".kn-note-editor .cm-rendered a[href='kiwi-footnote:custo']", "name": "o mouse no ³" },
    { "waitFor": ".kn-footnote-tip:has-text('R$ 4.200, sem os móveis')", "name": "o hover mostra o texto da nota, com o negrito desenhado" },
    { "screenshot": "01-hover.png" },
    { "hover": ".kn-note-editor .cm-rendered a[href^='kiwi-footnote-inline:']", "name": "o mouse na nota em linha" },
    { "waitFor": ".kn-footnote-tip:has-text('A Fio Certo confirmou')", "name": "o hover da nota em linha" },
    { "hover": ".kn-note-editor .cm-rendered a[href='kiwi-footnote-missing:2']", "name": "o mouse na que não tem texto" },
    { "waitFor": ".kn-footnote-tip.is-missing:has-text('ainda não tem texto')", "name": "o aviso de que falta o texto" },
    { "click": ".kn-note-editor .cm-rendered p:has-text('Falta escolher')", "name": "o cursor vai para o parágrafo" },
    { "press": "End" },
    { "type": " Ou fazer por conta /rodape" },
    { "waitFor": ".cm-tooltip-autocomplete li[aria-selected]:has-text('Nota de rodapé')", "name": "o / acha a nota de rodapé" },
    { "wait": 200, "name": "o autocomplete só aceita o Enter 75 ms depois de mudar (interactionDelay)" },
    { "press": "Enter" },
    { "type": "Pedir mais dois orçamentos." },
    { "waitFor": ".kn-note-editor .cm-line:has-text('[^3]: Pedir mais dois orçamentos.')", "name": "a chamada [^3] entra e o cursor vai para a definição no fim" },
    { "screenshot": "02-inserir-pelo-slash.png" },
    { "click": ".kn-note-editor .cm-rendered h1", "name": "o cursor sai, para o título" },
    { "press": "End" },
    { "press": "Shift+Home", "name": "seleciona o título" },
    { "click": ".kn-note-editor .cm-line.cm-h1", "button": "right", "name": "botão direito na seleção: a chamada entra logo depois dela" },
    { "hover": "[role=menuitem]:has-text('Inserir')" },
    { "waitFor": "[role=menuitem]:has-text('Nota de rodapé')", "name": "o menu Inserir tem Nota de rodapé" },
    { "screenshot": "03-menu-inserir.png" },
    { "click": "[role=menuitem]:has-text('Nota de rodapé')" },
    { "type": "Pelo menu." },
    { "waitFor": ".kn-note-editor .cm-line:has-text('[^4]: Pelo menu.')", "name": "a [^4] entra junto das outras" },
    { "waitFor": ".kn-note-editor .cm-rendered h1 a[href='kiwi-footnote:4']", "name": "a chamada no fim do título" },
    { "click": ".kn-note-editor .cm-rendered h1", "name": "o cursor sai de novo" },
    { "click": ".kn-note-editor .cm-rendered a[href='kiwi-footnote:1']", "name": "o clique no ¹ vai para a definição" },
    { "waitFor": ".kn-note-editor .cm-line:has-text('[^1]: Combinado na reunião')", "name": "a definição fica para editar" },
    { "wait": 1500, "name": "o editor salva" },
    { "invoke": "notes.get", "args": { "path": "Rodapé.md" }, "name": "o .md tem as chamadas e as definições no fim" }
  ]
}
