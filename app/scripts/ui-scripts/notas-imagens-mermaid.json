{
  "window": "notes",
  "steps": [
    {
      "invoke": "attachments.save",
      "args": {
        "name": "planta.png",
        "data": ""
      },
      "name": "um anexo no vault"
    },
    {
      "invoke": "notes.create",
      "args": {
        "title": "Imagens",
        "content": "Planta:\n\n![[planta.png]]\n\nTexto com ![[planta.png|120]] no meio e ![remota](https://example.com/a.png) de fora.\n\n```mermaid\ngraph TD\n  A[Ideia] --> B[Nota]\n```\n\nFim.\n"
      }
    },
    {
      "waitFor": ".kn-crumb-bt",
      "name": "a janela Notas abre"
    },
    {
      "press": "Meta+k"
    },
    {
      "type": "Imagens"
    },
    {
      "waitFor": ".kn-palette .kn-palette-it:has-text('Imagens')"
    },
    {
      "press": "Enter"
    },
    {
      "waitFor": ".kn-note-editor .cm-attachment img[alt='planta.png']",
      "name": "a linha do anexo é a imagem"
    },
    {
      "waitFor": ".kn-note-editor .cm-rendered img[src^='data:image/png']",
      "name": "o ![[planta.png]] no meio do texto vira imagem, lida do vault"
    },
    {
      "waitFor": ".kn-note-editor .cm-rendered a[href^='kiwi-load-image:']:has-text('remota')",
      "name": "a imagem de fora vira um cartão, sem carregar"
    },
    {
      "expectCount": ".kn-note-editor img[src^='http']",
      "count": 0,
      "name": "e nenhuma imagem de fora carrega"
    },
    {
      "waitFor": ".kn-note-editor .cm-rendered .kn-mermaid-drawn svg",
      "name": "o mermaid vira diagrama"
    },
    {
      "screenshot": "imagens.png"
    },
    {
      "click": ".kn-note-editor .cm-rendered a[href^='kiwi-load-image:']",
      "name": "clique no cartão da imagem de fora"
    },
    {
      "waitFor": ".kn-note-editor .cm-rendered img[src='https://example.com/a.png']",
      "name": "só agora a imagem de fora entra na nota (jow, #3039)"
    },
    {
      "click": ".kn-note-editor .cm-attachment img[alt='planta.png'] >> nth=0",
      "name": "clicar na imagem do anexo"
    },
    {
      "waitFor": ".kn-note-editor .cm-line:has-text('![[planta.png]]')",
      "name": "a linha vira texto para editar"
    },
    {
      "expectCount": ".kn-note-editor .cm-attachment img[alt='planta.png']",
      "count": 1,
      "name": "e a imagem continua à vista, embaixo da linha"
    },
    {
      "click": ".kn-note-editor .cm-rendered :text('no meio e')",
      "name": "clicar no texto do parágrafo com imagens"
    },
    {
      "waitFor": ".kn-note-editor .cm-line:has-text('![remota](https://example.com/a.png)')",
      "name": "o parágrafo fica cru para editar"
    },
    {
      "waitFor": ".kn-note-editor .cm-images-under img[src^='data:image/png']",
      "name": "e a imagem do anexo continua à vista embaixo dele"
    },
    {
      "waitFor": ".kn-note-editor .cm-images-under img[src='https://example.com/a.png']",
      "name": "a de fora também (já carregada pelo clique)"
    },
    {
      "screenshot": "imagens-paragrafo.png"
    },
    {
      "click": ".kn-note-editor .kn-mermaid-drawn",
      "name": "clicar no diagrama"
    },
    {
      "waitFor": ".kn-note-editor .cm-line:has-text('A[Ideia] --> B[Nota]')",
      "name": "o código do mermaid fica cru"
    },
    {
      "waitFor": ".kn-note-editor .cm-mermaid-under .kn-mermaid-drawn svg",
      "name": "e o diagrama continua embaixo dele"
    },
    {
      "screenshot": "imagens-editando.png"
    }
  ]
}
