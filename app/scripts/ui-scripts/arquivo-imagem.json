{
  "window": "notes",
  "steps": [
    { "waitFor": ".kn-crumb-bt", "name": "a janela Notas abre (antes, no cofre: Fotos/planta.png 2400 × 1200, Fotos/logo.svg com um <script> dentro, Fotos/bomba.png com cabeçalho de 30.000 × 30.000, Fotos/metadados.jpg (o mesmo tamanho depois de 74 KB de metadados), Fotos/falsa.png que é texto, e uma nota)" },
    { "click": ".kn-crumb-bt", "name": "abre a árvore" },
    { "click": ".kn-tree-pop .kn-side-item[data-kind='folder']:has-text('Fotos')", "name": "abre a pasta Fotos" },
    { "click": ".kn-tree-pop .kn-side-item[data-kind='file']:has-text('planta')", "name": "clica no png" },
    { "waitFor": ".kn-file[data-state='ready'] .kn-file-image-img", "name": "a imagem abre nas Notas" },
    { "expectText": ".kn-file-title", "text": "planta.png" },
    { "expectText": ".kn-file-pdf-page", "text": "2.400 × 1.200 px", "name": "o tamanho em pixels" },
    { "expectWidth": ".kn-file-image-img", "max": 1180, "name": "ajustada à janela: a imagem inteira cabe" },
    { "expectNoHScroll": ".kn-file-image", "name": "sem rolagem de lado no ajuste" },
    { "screenshot": "01-imagem.png" },
    { "click": ".kn-file-pdf-bar button:has-text('Tamanho real')", "name": "tamanho real" },
    { "expectText": ".kn-file-pdf-zoom", "text": "100%" },
    { "expectWidth": ".kn-file-image-img", "min": 2399, "max": 2401, "name": "2400 px de largura" },
    { "scroll": ".kn-file-image-area", "y": 300, "x": 600, "name": "rola a imagem grande" },
    { "expectScroll": ".kn-file-image-area", "min": 100 },
    { "click": ".kn-file-pdf-bar button[aria-label='Diminuir o zoom']", "name": "diminui o zoom" },
    { "expectText": ".kn-file-pdf-zoom", "text": "75%" },
    { "expectWidth": ".kn-file-image-img", "min": 1799, "max": 1801 },
    { "click": ".kn-file-pdf-bar button:has-text('Ajustar à janela')", "name": "volta a ajustar" },
    { "expectWidth": ".kn-file-image-img", "max": 1180 },
    { "click": ".kn-crumb-bt", "name": "abre a árvore" },
    { "click": ".kn-tree-pop .kn-side-item[data-kind='file']:has-text('logo')", "name": "clica no svg com script" },
    { "waitFor": ".kn-file-image-img[src^='data:image/svg+xml']", "name": "o svg aparece como imagem" },
    { "wait": 500 },
    { "expectText": ".kn-file-title", "text": "logo.svg", "name": "e o script dele não rodou (a página segue sem erro nem diálogo)" },
    { "screenshot": "02-svg.png" },
    { "click": ".kn-crumb-bt", "name": "abre a árvore" },
    { "click": ".kn-tree-pop .kn-side-item[data-kind='file']:has-text('bomba')", "name": "clica na bomba de pixels" },
    { "waitFor": ".kn-file-notice:has-text('30.000 × 30.000 pixels')", "name": "recusada antes de decodificar" },
    { "expectCount": ".kn-file-image-img", "count": 0 },
    { "screenshot": "03-bomba.png" },
    { "click": ".kn-crumb-bt", "name": "abre a árvore" },
    { "click": ".kn-tree-pop .kn-side-item[data-kind='file']:has-text('metadados')", "name": "um jpeg 30.000 × 30.000 com 74 KB de metadados antes do tamanho (rodada 1)" },
    { "waitFor": ".kn-file-notice:has-text('30.000 × 30.000 pixels')", "name": "o tamanho é achado no arquivo inteiro, e ele é recusado" },
    { "expectCount": ".kn-file-image-img", "count": 0 },
    { "click": ".kn-crumb-bt", "name": "abre a árvore" },
    { "click": ".kn-tree-pop .kn-side-item[data-kind='file']:has-text('falsa')", "name": "clica no texto com nome de png" },
    { "waitFor": ".kn-file-notice:has-text('Não deu para mostrar esta imagem')", "name": "o nome não engana" },
    { "click": ".kn-crumb-bt", "name": "abre a árvore" },
    { "click": ".kn-tree-pop .kn-side-item[data-kind='note']", "name": "clicar numa nota volta para o editor" },
    { "waitFor": ".kn-note-editor .cm-content" },
    { "expectCount": ".kn-file", "count": 0 }
  ]
}
