{
  "window": "hub",
  "steps": [
    { "invoke": "settings.set", "args": { "appearance": { "mode": "light", "darkTheme": "channels-oled", "lightTheme": "channels-light", "textSize": "default", "font": "system", "motion": "full" } }, "name": "começa no claro, nos padrões" },
    { "waitFor": ".kn-tab", "name": "o hub abre" },
    { "waitFor": "html[data-theme='light'][data-theme-id='channels-light'] body", "name": "a janela pinta no Channels Light" },
    { "click": ".kn-tab:has-text('Configurações')", "name": "vai para Configurações" },
    { "click": ".kn-prefs-item[data-topic=appearance]", "name": "o assunto appearance da barra lateral (#11966)" },
    { "expectText": ".kn-themes-sub", "text": "Escuros 29", "name": "os 29 escuros" },
    { "expectCount": ".kn-theme", "count": 44, "name": "e os 44 temas" },
    { "click": ".kn-segmented button:has-text('Escuro')", "name": "Modo: Escuro" },
    { "waitFor": "html[data-theme='dark'][data-theme-id='channels-oled'] body", "name": "troca na hora para o OLED Black" },
    { "click": ".kn-theme:has-text('Abyssal Trench')", "name": "escolhe o Abyssal Trench" },
    { "waitFor": "html[data-theme-id='abyssal-trench'] body", "name": "a janela troca de tema" },
    { "expectCount": ".kn-theme[aria-pressed='true']:has-text('Abyssal Trench')", "count": 1, "name": "e ele fica marcado" },
    { "invoke": "settings.set", "args": { "appearance": { "darkTheme": "neon-arcade" } }, "name": "outra janela muda o tema (o engine avisa todas)" },
    { "waitFor": "html[data-theme-id='neon-arcade'] body", "name": "esta troca pelo settings.changed, sem recarregar" },
    { "click": ".kn-theme:has-text('Glacier Mint')", "name": "um tema claro com o modo Escuro" },
    { "waitFor": "html[data-theme='light'][data-theme-id='glacier-mint'] body", "name": "o modo vai junto para Claro" },
    { "click": ".kn-segmented button:has-text('Grande')", "name": "Tamanho do texto: Grande" },
    { "waitFor": "html[style*='--text-scale: 1.14'] body", "name": "o zoom de 1.14" },
    { "click": ".kn-segmented button:has-text('Inter')", "name": "Fonte: Inter" },
    { "waitFor": "html[data-font='inter'] body", "name": "a fonte troca" },
    { "click": ".kn-segmented button:has-text('Reduzido')", "name": "Movimento: Reduzido" },
    { "waitFor": "html[data-motion='reduced'] body", "name": "as animações param" },
    { "screenshot": "aparencia.png" },
    { "fill": "#kn-theme-search", "text": "mint", "name": "busca por nome" },
    { "expectCount": ".kn-theme", "count": 1, "name": "só o Glacier Mint" },
    { "invoke": "settings.set", "args": { "appearance": { "mode": "system", "darkTheme": "channels-oled", "lightTheme": "channels-light", "textSize": "default", "font": "system", "motion": "full" } }, "name": "volta aos padrões" },
    { "waitFor": "html:not([data-font]):not([data-motion]) body", "name": "e a janela também" }
  ]
}
