{
  "window": "notes",
  "steps": [
    { "invoke": "notes.create", "args": { "title": "Feira de sábado", "content": "Comprar frutas e pão\n" } },
    { "waitFor": ".kn-crumb-bt" },
    { "press": "Meta+k" },
    { "type": "Feira de sábado" },
    { "waitFor": ".kn-palette-it:has-text('Feira de sábado')" },
    { "press": "Enter" },
    { "waitFor": ".cm-content" },
    { "click": ".cm-content" },
    { "press": "Meta+Home" },
    { "press": "End" },
    { "press": "Shift+Home" },
    { "click": ".cm-line:has-text('Comprar frutas')", "button": "right", "position": { "x": 20, "y": 8 } },
    { "waitFor": ".kn-menu [role=menuitem]:has-text('Formatar')" },
    { "hover": ".kn-menu-item:has-text('Formatar')" },
    { "waitFor": "[role=menu][aria-label='Formatar']" },
    { "screenshot": "01-formatar.png" },
    { "hover": ".kn-menu-item:has-text('Parágrafo')" },
    { "waitFor": "[role=menu][aria-label='Parágrafo']" },
    { "expectCount": "[aria-label='Parágrafo'] svg.kn-menu-icon", "count": 5, "name": "as listas, a citação e o marcar tarefa com ícone" },
    { "screenshot": "02-paragrafo.png" },
    { "hover": ".kn-menu-item:has-text('Inserir')" },
    { "waitFor": "[role=menu][aria-label='Inserir']" },
    { "expectCount": "[aria-label='Inserir'] svg.kn-menu-icon", "count": 7, "name": "cada opção do Inserir com o seu ícone" },
    { "screenshot": "03-inserir.png" },
    { "press": "Escape" },
    { "press": "Escape" },
    { "waitFor": ".kn-menu", "state": "hidden" },
    { "click": ".cm-content" },
    { "press": "Meta+End" },
    { "type": "/" },
    { "waitFor": ".cm-tooltip-autocomplete .kn-slash-icon svg[data-icon='h1']", "name": "o menu do / abre com o ícone do título" },
    { "waitFor": ".cm-tooltip-autocomplete .kn-slash-icon svg[data-icon='table']" },
    { "screenshot": "04-barra.png" }
  ]
}
