{
  "window": "notes",
  "steps": [
    { "waitFor": ".kn-crumb-bt", "name": "a janela Notas abre (antes, no cofre: Docs/relatorio.pdf, a cópia de test/fixtures/files/relatorio.pdf, e uma nota)" },
    { "click": ".kn-crumb-bt", "name": "abre a árvore" },
    { "click": ".kn-tree-pop .kn-side-item[data-kind='folder']:has-text('Docs')", "name": "abre a pasta Docs" },
    { "click": ".kn-tree-pop .kn-side-item[data-kind='file']:has-text('relatorio')", "name": "clica no pdf" },
    { "waitFor": ".kn-file[data-state='ready'] .kn-file-pdf-sheet[data-rendered='true']", "timeout": 20000, "name": "o pdf abre nas Notas e a primeira página é desenhada" },
    { "expectText": ".kn-file-title", "text": "relatorio.pdf" },
    { "expectCount": ".kn-file-pdf-sheet", "count": 3, "name": "as 3 páginas, uma embaixo da outra" },
    { "expectText": ".kn-file-pdf-page", "text": "Página 1 de 3" },
    { "expectText": ".kn-file-pdf-zoom", "text": "150%", "name": "ajustado à largura, até 150%" },
    { "screenshot": "01-pdf.png" },
    { "scroll": ".kn-file-pdf-scroll", "y": 1500, "name": "rola as páginas" },
    { "expectScroll": ".kn-file-pdf-scroll", "min": 800 },
    { "waitFor": ".kn-file-pdf-page:has-text('Página 2 de 3')", "name": "o número da página acompanha a rolagem" },
    { "click": ".kn-file-pdf-bar button[aria-label='Diminuir o zoom']", "name": "diminui o zoom" },
    { "expectText": ".kn-file-pdf-zoom", "text": "125%" },
    { "click": ".kn-file-pdf-bar button[aria-label='Diminuir o zoom']" },
    { "expectText": ".kn-file-pdf-zoom", "text": "100%" },
    { "expectWidth": ".kn-file-pdf-sheet[data-page='1']", "min": 594, "max": 596, "name": "a página fica com a largura do A4 em 100% (595 pt)" },
    { "click": ".kn-file-pdf-bar button[aria-label='Aumentar o zoom']", "name": "aumenta o zoom" },
    { "expectText": ".kn-file-pdf-zoom", "text": "125%" },
    { "fill": ".kn-file-pdf-query", "text": "relatorio", "name": "busca sem acento" },
    { "waitFor": ".kn-file-pdf-count:has-text('1 de 4')", "name": "4 achados no documento" },
    { "waitFor": ".kn-file-pdf-sheet[data-page='1'] .kn-file-pdf-mark[data-current]", "name": "o primeiro achado, na página 1, marcado como o da vez" },
    { "expectCount": ".kn-file-pdf-sheet[data-page='1'] .kn-file-pdf-mark", "count": 2, "name": "os 2 achados da página 1 marcados" },
    { "screenshot": "02-busca.png" },
    { "click": ".kn-file-pdf-query" },
    { "press": "Enter", "name": "Enter vai para o próximo achado" },
    { "press": "Enter" },
    { "waitFor": ".kn-file-pdf-count:has-text('3 de 4')" },
    { "waitFor": ".kn-file-pdf-sheet[data-page='2'] .kn-file-pdf-mark[data-current]", "name": "o terceiro achado está na página 2" },
    { "waitFor": ".kn-file-pdf-page:has-text('Página 2 de 3')", "name": "e a página 2 veio para a tela" },
    { "screenshot": "03-proximo.png" },
    { "press": "Shift+Enter", "name": "Shift+Enter volta" },
    { "waitFor": ".kn-file-pdf-count:has-text('2 de 4')" },
    { "fill": ".kn-file-pdf-query", "text": "abacaxi", "name": "um termo que não existe" },
    { "waitFor": ".kn-file-pdf-count:has-text('Nada encontrado')" },
    { "expectCount": ".kn-file-pdf-mark", "count": 0 },
    { "click": ".kn-crumb-bt", "name": "abre a árvore" },
    { "click": ".kn-tree-pop .kn-side-item[data-kind='note']", "name": "clicar numa nota volta para o editor" },
    { "waitFor": ".kn-note-editor .cm-content" },
    { "expectCount": ".kn-file", "count": 0 }
  ]
}
