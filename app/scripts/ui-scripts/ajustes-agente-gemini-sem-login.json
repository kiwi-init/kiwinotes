{
  "window": "hub",
  "size": "900x1400",
  "steps": [
    {
      "waitFor": ".kn-tab",
      "name": "o hub abre"
    },
    {
      "click": ".kn-tab:has-text('Configurações')"
    },
    {
      "click": ".kn-prefs-item[data-topic=agent]",
      "name": "o assunto agent"
    },
    {
      "waitFor": ".kn-row:has(.kn-row-label:text-is('Gemini (Antigravity) · não escolhido')) .kn-row-hint:not(:has-text('Conferindo'))",
      "name": "o Gemini conferido, sem ser o escolhido"
    },
    {
      "expectText": ".kn-row:has(.kn-row-label:text-is('Gemini (Antigravity) · não escolhido')) .kn-row-hint",
      "text": "O login se confere no primeiro pedido",
      "name": "o login do Gemini ainda não se sabe, e não vira \"não logado\""
    },
    {
      "click": ".kn-segmented button:has-text('Gemini')",
      "name": "escolhe o Gemini"
    },
    {
      "waitFor": ".kn-segmented [aria-checked=true]:has-text('Gemini')",
      "name": "desligado, a troca é direta: nada vai a lugar nenhum"
    },
    {
      "expectText": ".kn-segmented [aria-checked=true]:has-text('Gemini')",
      "text": "Gemini (Antigravity)",
      "name": "o nome diz o programa: o Gemini vem pelo Antigravity CLI (spec #25046)"
    },
    {
      "expectCount": ".kn-agent-consent",
      "count": 0,
      "name": "sem a tela da troca: ela vem ao ligar (não duas iguais seguidas)"
    },
    {
      "waitFor": ".kn-row:has(.kn-row-label:text-is('Claude Code · não escolhido'))",
      "name": "o Claude Code fica embaixo, para comparar"
    },
    {
      "expectCount": ".kn-row:has(.kn-row-label:text-is('Adaptador'))",
      "count": 0,
      "name": "sem a linha do adaptador"
    },
    {
      "click": ".kn-row:has(.kn-row-label:text-is('Ligar o agente')) [role=switch]",
      "name": "liga"
    },
    {
      "waitFor": ".kn-agent-consent h3:text-is('Antes de ligar o Gemini (Antigravity)')",
      "name": "o aviso do ADR 0011 com o Gemini"
    },
    {
      "click": ".kn-agent-consent button:has-text('Ligar o Gemini')",
      "name": "aceita e liga"
    },
    {
      "waitFor": ".kn-onb",
      "name": "o onboarding abre"
    },
    {
      "press": "Escape"
    },
    {
      "waitFor": ".kn-onb",
      "state": "detached"
    },
    {
      "expectCount": ".kn-row:has(.kn-row-label:text-is('Adaptador'))",
      "count": 0,
      "name": "ligado com o Gemini, sem a linha do adaptador"
    },
    {
      "waitFor": ".kn-agent-test",
      "name": "o Testar aparece sem baixar nada"
    },
    {
      "click": ".kn-agent-test button:has-text('Testar')",
      "name": "manda o pedido de teste ao Gemini falso"
    },
    {
      "expectText": ".kn-row:has(.kn-row-label:text-is('Gemini (Antigravity)')) .kn-row-hint",
      "text": "Abra o Antigravity no Terminal e entre com a sua conta",
      "timeout": 30000,
      "name": "o authRequired vira \"não logado\": a linha diz como entrar, pelo próprio Gemini"
    },
    {
      "expectCount": ".kn-agent-test",
      "count": 0,
      "name": "sem login, o Testar sai"
    },
    {
      "wait": 400
    },
    {
      "scroll": ".kn-section:has(h2:text-is('Agente'))",
      "y": -20000,
      "name": "volta ao topo: a seção é mais alta que a janela, e o print do elemento sai em branco"
    },
    {
      "wait": 300
    },
    {
      "screenshot": "3-sem-login.png"
    }
  ]
}
