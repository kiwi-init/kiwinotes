{
  "window": "notes",
  "steps": [
    { "waitFor": ".kn-crumb-bt", "name": "a janela Notas abre (antes, no cofre: Dados/vendas.csv com 1200 linhas e separador ';', Dados/contatos.tsv, Dados/excel.csv em Windows-1252 com a linha sep=;, Dados/largo.csv com 5000 colunas e uma nota; o planilha-check.ts monta tudo)" },
    { "click": ".kn-crumb-bt", "name": "abre a árvore" },
    { "click": ".kn-tree-pop .kn-side-item[data-kind='folder']:has-text('Dados')", "name": "abre a pasta Dados" },
    { "click": ".kn-tree-pop .kn-side-item[data-kind='file']:has-text('vendas')", "name": "clica no csv" },
    { "waitFor": ".kn-file[data-state='ready'] .kn-grid .kn-grid-cell", "name": "o csv abre nas Notas, na grade" },
    { "expectText": ".kn-file-title", "text": "vendas.csv" },
    { "expectCount": ".kn-grid-top [role='columnheader']", "count": 4, "name": "a linha de cima com as 4 colunas (o separador é ponto e vírgula)" },
    { "expectText": ".kn-grid-top", "text": "Observação" },
    { "expectText": ".kn-grid-row[aria-rowindex='3']", "text": "Sala, com vista; e varanda", "name": "o campo entre aspas guarda o separador" },
    { "expectText": ".kn-file-table-foot", "text": "1.200 linhas, 4 colunas", "name": "o rodapé diz o total" },
    { "expectCount": ".kn-file-table-more", "count": 0, "name": "sem o Mostrar mais: todas as linhas na grade" },
    { "expectCount": ".kn-file-text-area", "count": 0, "name": "só leitura: sem editor" },
    { "screenshot": "01-tabela.png" },
    { "scroll": ".kn-grid", "y": 30000, "name": "rola a tabela" },
    { "expectScroll": ".kn-grid", "min": 20000, "name": "as linhas rolam" },
    { "waitFor": ".kn-grid-row[aria-rowindex='1005']", "name": "a linha 1006, lá embaixo, montada na rolagem" },
    { "screenshot": "02-rolada.png", "name": "o print mostra a linha de cima parada no alto com as linhas roladas" },
    { "click": ".kn-crumb-bt", "name": "abre a árvore de novo" },
    { "click": ".kn-tree-pop .kn-side-item[data-kind='file']:has-text('contatos')", "name": "clica no tsv" },
    { "waitFor": ".kn-file[data-state='ready'] .kn-grid-top:has-text('Telefone')", "name": "o tsv também abre na grade" },
    { "expectCount": ".kn-grid-top [role='columnheader']", "count": 3, "name": "3 colunas separadas por tab" },
    { "expectText": ".kn-file-table-foot", "text": "2 linhas, 3 colunas" },
    { "screenshot": "03-tsv.png" },
    { "click": ".kn-crumb-bt", "name": "abre a árvore" },
    { "click": ".kn-tree-pop .kn-side-item[data-kind='file']:has-text('excel')", "name": "clica no csv do Excel em Windows-1252" },
    { "waitFor": ".kn-grid-top [role='columnheader']:has-text('Descrição')", "name": "os acentos saem certos na linha de cima" },
    { "expectText": ".kn-grid", "text": "Ação" },
    { "expectText": ".kn-file-table-foot", "text": "lido como Windows-1252", "name": "e o rodapé diz a codificação" },
    { "expectCount": ".kn-grid-top [role='columnheader']", "count": 3, "name": "a linha sep=; do Excel não vira cabeçalho" },
    { "screenshot": "04-excel.png" },
    { "click": ".kn-crumb-bt", "name": "abre a árvore" },
    { "click": ".kn-tree-pop .kn-side-item[data-kind='file']:has-text('largo')", "name": "clica no csv de 5000 colunas" },
    { "waitFor": ".kn-file-table-foot:has-text('5.000 colunas')", "name": "todas as colunas, sem corte" },
    { "expectCount": ".kn-file-table-note", "count": 0, "name": "sem o aviso das colunas de fora" },
    { "scroll": ".kn-grid", "x": 100000, "name": "rola para a direita (a roda anda em passos; 5000 colunas são uns 320.000 px)" },
    { "scroll": ".kn-grid", "x": 100000 },
    { "scroll": ".kn-grid", "x": 100000 },
    { "scroll": ".kn-grid", "x": 100000, "name": "até a última coluna" },
    { "waitFor": ".kn-grid-letter:has-text('GJH')", "name": "a coluna 5000 (GJH) montada na rolagem" },
    { "screenshot": "05-largo.png" }
  ]
}
