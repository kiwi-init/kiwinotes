{
  "window": "notes",
  "steps": [
    { "invoke": "files.create", "args": { "folder": "Casa", "name": "feira.txt", "base64": "TGlzdGEgZGEgZmVpcmEKYmFuYW5hCm1hw6fDowo=" }, "name": "engine: um .txt inventado" },
    { "waitFor": ".kn-crumb-bt", "name": "a janela Notas abre" },
    { "click": ".kn-crumb-bt", "name": "abre a árvore" },
    { "click": ".kn-tree-pop .kn-side-item[data-kind='folder']:has-text('Casa')", "name": "abre a pasta Casa" },
    { "click": ".kn-tree-pop .kn-side-item[data-kind='file']:has-text('feira')", "name": "abre o feira.txt" },
    { "waitFor": ".kn-file-text .cm-content:has-text('banana')", "name": "o texto na tela" },
    { "click": ".kn-file-text .cm-content", "name": "o editor" },
    { "press": "Meta+ArrowDown", "name": "o fim" },
    { "type": "pão\nleite\n", "name": "a pessoa digita" },
    { "waitFor": ".kn-file-text[data-save='saved']", "name": "o texto grava (e o histórico guarda o de antes e o novo)" },
    { "click": ".kn-file-versions", "name": "o botão Versões no topo do arquivo" },
    { "waitFor": ".kn-versions", "name": "o painel abre" },
    { "expectCount": ".kn-versions-it", "count": 2, "name": "duas versões: a original e a editada" },
    { "click": ".kn-versions-it >> nth=1", "name": "a mais velha" },
    { "expectText": ".kn-versions-stats", "text": "tira 2 linhas", "name": "o Restaurar tira as duas linhas novas" },
    { "expectCount": ".kn-diff-del", "count": 2 },
    { "screenshot": "versoes-txt.png" },
    { "click": ".kn-versions-actions .kn-bt", "name": "Restaurar esta versão" },
    { "expectCount": ".kn-versions", "count": 0, "name": "o painel fecha" },
    { "waitFor": ".kn-file-text .cm-content:has-text('leite')", "state": "detached", "name": "o texto voltou para o original" },
    { "invoke": "files.read", "args": { "path": "Casa/feira.txt", "as": "text" }, "expect": { "text": "Lista da feira\nbanana\nmaçã\n" }, "name": "o disco também" },
    { "click": ".kn-crumb-bt", "name": "abre a árvore" },
    { "click": ".kn-tree-pop .kn-side-item[data-kind='file']:has-text('feira')", "button": "right", "name": "o botão direito no .txt" },
    { "click": ".kn-menu-item:has-text('Versões')", "name": "Versões… pelo menu da árvore" },
    { "waitFor": ".kn-versions-it >> nth=2", "name": "o restaurar também virou versão (dá para voltar dele)" },
    { "click": ".kn-versions button:has-text('Fechar')", "name": "fecha o painel" },
    { "invoke": "files.create", "args": { "folder": "Casa", "name": "gastos.csv", "base64": "ZGlhO3RvdGFsCnNlZzsxMAp0ZXI7MTIK" }, "name": "engine: um .csv inventado" },
    { "click": ".kn-crumb-bt", "name": "abre a árvore" },
    { "click": ".kn-tree-pop .kn-side-item[data-kind='file']:has-text('gastos')", "name": "abre o gastos.csv" },
    { "waitFor": ".kn-file[data-state='ready'] .kn-grid-row[aria-rowindex='3'] [aria-colindex='3']", "name": "a grade" },
    { "click": ".kn-grid-row[aria-rowindex='3'] [aria-colindex='3']", "name": "a célula do 12" },
    { "type": "15", "name": "a pessoa troca o 12 por 15" },
    { "press": "Enter" },
    { "wait": 1500, "name": "a planilha grava (em bytes) e o histórico guarda" },
    { "click": ".kn-file-versions", "name": "Versões do csv" },
    { "waitFor": ".kn-versions-it >> nth=1", "name": "a original e a editada" },
    { "click": ".kn-versions-it >> nth=1", "name": "a mais velha" },
    { "expectText": ".kn-versions-stats", "text": "traz 1 e tira 1 linha", "name": "o diff do texto da tabela" },
    { "screenshot": "versoes-csv.png" },
    { "click": ".kn-versions-actions .kn-bt", "name": "Restaurar a do 12" },
    { "expectCount": ".kn-versions", "count": 0, "name": "o painel fecha" },
    { "invoke": "files.read", "args": { "path": "Casa/gastos.csv", "as": "text" }, "expect": { "text": "dia;total\nseg;10\nter;12\n" }, "name": "o disco voltou" },
    { "expectText": ".kn-grid-row[aria-rowindex='3'] [aria-colindex='3']", "text": "12", "name": "a grade também" }
  ]
}
