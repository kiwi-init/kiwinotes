{
  "window": "notes",
  "steps": [
    { "waitFor": ".kn-crumb-bt", "name": "a janela Notas abre (antes, no cofre: Diagramas/fluxo.drawio de test/fixtures, com 2 páginas e um rótulo com <img onerror>; Diagramas/hostil.drawio de test/fixtures, com um rótulo position:fixed que tenta cobrir a janela, links javascript:, <script>, <img onerror>, imagens de https://exemplo.invalid (forma, indicador e fundo da página), fonte do Google, extFonts e fórmula com math=1; Diagramas/bomba.drawio com uma página comprimida de 30 MB; Diagramas/quebrado.drawio que é texto; Diagramas/exportado.drawio.svg; e uma nota)" },
    { "click": ".kn-crumb-bt", "name": "abre a árvore" },
    { "click": ".kn-tree-pop .kn-side-item[data-kind='folder']:has-text('Diagramas')", "name": "abre a pasta Diagramas" },
    { "click": ".kn-tree-pop .kn-side-item[data-kind='file']:has-text('fluxo')", "name": "clica no .drawio" },
    { "waitFor": ".kn-file-drawio[data-state='ready'] .kn-file-drawio-graph svg", "name": "o diagrama abre no viewer do draw.io, do pack" },
    { "expectText": ".kn-file-title", "text": "fluxo.drawio" },
    { "expectText": ".kn-file-drawio-graph", "text": "Pedido chega", "name": "os rótulos da página 1" },
    { "expectText": ".kn-file-drawio-graph", "text": "1 / 2", "name": "as páginas do arquivo" },
    { "wait": 300 },
    { "screenshot": "01-drawio.png" },
    { "click": ".kn-file-drawio-graph [title='Próxima página']", "name": "vai para a página 2" },
    { "expectText": ".kn-file-drawio-graph", "text": "2 / 2" },
    { "expectText": ".kn-file-drawio-graph", "text": "Segunda página", "name": "a página 2, que vem comprimida no arquivo" },
    { "click": ".kn-file-drawio-graph [title='Aumentar o zoom']", "name": "aumenta o zoom" },
    { "click": ".kn-file-drawio-graph [title='Aumentar o zoom']" },
    { "wait": 300 },
    { "screenshot": "02-pagina-2-zoom.png" },
    { "click": ".kn-file-drawio-graph [title='Ajustar à janela']", "name": "volta a ajustar" },
    { "click": ".kn-crumb-bt", "name": "abre a árvore" },
    { "click": ".kn-tree-pop .kn-side-item[data-kind='file']:has-text('hostil')", "name": "o diagrama hostil" },
    { "waitFor": ".kn-file-drawio[data-state='ready'] .kn-file-drawio-graph svg" },
    { "expectText": ".kn-file-drawio-graph a[href='https://exemplo.invalid/']", "text": "Rótulo", "name": "o link https fica (clicar abre no navegador)" },
    { "expectCount": ".kn-file-drawio-graph a[href*='script:' i]", "count": 0, "name": "os links javascript: saem, também com o tab no meio" },
    { "expectCount": ".kn-file-drawio-graph script, .kn-file-drawio-graph [onerror]", "count": 0, "name": "nem <script> nem onerror entram" },
    { "expectCount": ".kn-file-drawio-graph img[src^='http'], .kn-file-drawio-graph image[href^='http'], .kn-file-drawio-graph image[*|href^='http']", "count": 0, "name": "nenhuma imagem de fora na página (forma, indicador, fundo)" },
    { "expectCount": "link[href*='googleapis'], style:has-text('googleapis'), script[src*='diagrams.net'], script[src*='mathjax']", "count": 0, "name": "nem fonte do Google nem o MathJax de fora: nada é pedido (blocked e problems vazios no fim)" },
    { "expectText": ".kn-file-drawio-graph", "text": "x^2 + y^2", "name": "a fórmula aparece como texto" },
    { "wait": 1000 },
    { "screenshot": "03-hostil.png" },
    { "hover": ".kn-crumb-bt", "name": "o rótulo position:fixed fica preso na área do diagrama: a barra das Notas, fora dela, segue livre" },
    { "click": ".kn-crumb-bt", "name": "abre a árvore" },
    { "click": ".kn-tree-pop .kn-side-item[data-kind='file']:has-text('bomba')", "name": "a página comprimida de 30 MB" },
    { "waitFor": ".kn-file-drawio[data-state='tooLarge'] .kn-file-notice:has-text('grande demais')", "name": "recusada antes de abrir" },
    { "expectCount": ".kn-file-drawio-graph", "count": 0 },
    { "screenshot": "04-bomba.png" },
    { "click": ".kn-crumb-bt", "name": "abre a árvore" },
    { "click": ".kn-tree-pop .kn-side-item[data-kind='file']:has-text('quebrado')", "name": "um .drawio que não é diagrama" },
    { "waitFor": ".kn-file-drawio[data-state='error'] .kn-file-notice:has-text('Não deu para abrir este diagrama')" },
    { "click": ".kn-crumb-bt", "name": "abre a árvore" },
    { "click": ".kn-tree-pop .kn-side-item[data-kind='file']:has-text('exportado')", "name": "o .drawio.svg" },
    { "waitFor": ".kn-file[data-state='ready'] .kn-file-image-img", "name": "abre como imagem" },
    { "expectText": ".kn-file-title", "text": "exportado.drawio.svg" },
    { "screenshot": "05-drawio-svg.png" },
    { "click": ".kn-crumb-bt", "name": "abre a árvore" },
    { "click": ".kn-tree-pop .kn-side-item[data-kind='note']", "name": "clicar numa nota volta para o editor" },
    { "waitFor": ".kn-note-editor .cm-content" },
    { "expectCount": ".kn-file", "count": 0 }
  ]
