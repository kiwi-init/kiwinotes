{
  "window": "notes",
  "steps": [
    { "invoke": "notes.create", "args": { "title": "Sumário E9", "content": "# Primeiro\n\nTexto um.\n\n## Filho\n\nFilho do primeiro.\n\n# Segundo\n\nTexto dois.\n" } },
    { "waitFor": ".kn-crumb-bt" },
