{
  "window": "notes",
  "steps": [
    {
      "invoke": "files.create",
      "args": {
        "folder": "Docs",
        "name": "proposta.docx",
        "base64": ""
      },
      "name": "engine: um docx inventado (a proposta.docx das fixtures)"
    },
    {
      "waitFor": ".kn-crumb-bt",
      "name": "a janela Notas abre"
    },
    {
      "click": ".kn-crumb-bt",
      "name": "abre a árvore"
    },
    {
      "click": ".kn-tree-pop .kn-side-item[data-kind='folder']:has-text('Docs')",
      "name": "abre a pasta Docs"
    },
    {
      "click": ".kn-tree-pop .kn-side-item[data-kind='file']:has-text('proposta')",
      "name": "abre o proposta.docx"
    },
    {
      "waitFor": ".kn-file[data-state='ready'] .docx-page",
      "name": "as páginas do docx"
    },
    {
      "name": "o cursor no título",
      "click": ".kn-file .docx-page :text('Proposta de mudança')"
    },
    {
      "press": "End"
    },
    {
      "type": " da Ana",
      "name": "a pessoa escreve no fim do título"
    },
    {
      "wait": 1500,
      "name": "o docx grava, e o histórico guarda o original e o novo"
    },
    {
      "click": ".kn-file-versions",
      "name": "o botão Versões no topo do docx"
    },
    {
      "waitFor": ".kn-versions-it >> nth=1",
      "name": "a original e a editada"
    },
    {
      "click": ".kn-versions-it >> nth=1",
      "name": "a mais velha"
    },
    {
      "waitFor": ".kn-versions-preview .docx-page:has-text('Proposta de mudança')",
      "name": "a versão abre nas páginas do docx"
    },
    {
      "waitFor": ".kn-versions-preview .docx-page:has-text('da Ana')",
      "state": "detached",
      "name": "a versão é a de antes da edição"
    },
    {
      "expectText": ".kn-versions-preview",
      "text": "Só leitura: a versão de",
      "name": "só leitura, e diz por quê"
    },
    {
      "expectText": ".kn-versions-stats",
      "text": "Restaurar troca o arquivo de agora por esta versão"
    },
    {
      "screenshot": "versoes-docx.png"
    },
    {
      "click": ".kn-versions-actions .kn-bt",
      "name": "Restaurar a de antes"
    },
    {
      "expectCount": ".kn-versions",
      "count": 0,
      "name": "o painel fecha"
    },
    {
      "waitFor": ".kn-file .docx-page:has-text('da Ana')",
      "state": "detached",
      "name": "o docx aberto volta ao de antes"
    },
    {
      "expectText": ".kn-file .docx-page",
      "text": "Proposta de mudança"
    },
    {
      "expectCount": ".kn-file-text-note",
      "count": 0,
      "name": "sem aviso: o restaurar não é uma mudança de fora com edição perdida"
    }
  ]
}
