{
  "window": "notes",
  "steps": [
    { "invoke": "notes.create", "args": { "folder": "Projetos", "title": "Plano", "content": "Ver ![[exemplo.pdf]] e [a tabela](dados.csv).\n" } },
    { "invoke": "files.create", "args": { "folder": "Projetos", "name": "exemplo.pdf", "base64": "JVBERi0xLjQK" } },
    { "invoke": "files.create", "args": { "folder": "Projetos", "name": "dados.csv", "base64": "YSxiCjEsMgo=" } },
    { "waitFor": ".kn-crumb-bt", "name": "a janela Notas abre" },
    { "click": ".kn-crumb-bt", "name": "abre a árvore" },
    { "click": ".kn-tree-pop .kn-side-item[data-kind='folder']:has-text('Projetos')", "name": "abre a pasta Projetos" },
    { "waitFor": ".kn-tree-pop .kn-side-item[data-kind='file'][data-type='pdf']:has-text('exemplo')", "name": "o PDF na árvore" },
    { "click": ".kn-tree-pop .kn-side-item[data-kind='file']:has-text('exemplo')", "button": "right", "name": "o botão direito no PDF" },
    { "waitFor": ".kn-menu-item:has-text('Mostrar no Finder')", "name": "o menu abre" },
    { "expectCount": ".kn-menu-item:has-text('Abrir')", "count": 2, "name": "Abrir (o PDF abre no Kiwi) e Abrir no app padrão" },
    { "expectCount": ".kn-menu-item:has-text('Copiar caminho')", "count": 1 },
    { "expectCount": ".kn-menu-item:has-text('Renomear')", "count": 1 },
    { "expectCount": ".kn-menu-item:has-text('Mover para')", "count": 1 },
    { "expectCount": ".kn-menu-item:has-text('Apagar')", "count": 1 },
    { "expectCount": ".kn-menu-item:has-text('Fixar'), .kn-menu-item:has-text('Duplicar'), .kn-menu-item:has-text('Versões'), .kn-menu-item:has-text('nota principal')", "count": 0, "name": "nada que é só de nota" },
    { "expectCount": ".kn-tree-pop .kn-side-row[data-menu] .kn-side-item[data-kind='file']", "count": 1, "name": "a linha do PDF fica marcada com o menu aberto" },
    { "screenshot": "menu-arquivo.png" },
    { "click": ".kn-menu-item:has-text('Renomear')" },
    { "waitFor": ".kn-tree-pop .kn-side-rename", "name": "o campo de renomear, com o nome sem a extensão" },
    { "fill": ".kn-tree-pop .kn-side-rename", "text": "Relatório" },
    { "press": "Enter" },
    { "waitFor": ".kn-tree-pop .kn-side-item[data-kind='file'][data-type='pdf']:has-text('Relatório')", "name": "o PDF renomeado, com a extensão de antes" },
    { "invoke": "notes.get", "args": { "path": "Projetos/Plano.md" }, "expect": { "content": "Ver ![[Relatório.pdf]] e [a tabela](dados.csv).\n" }, "name": "o link da nota seguiu o PDF" },
    { "click": ".kn-tree-pop .kn-side-item[data-kind='file']:has-text('dados')", "button": "right", "name": "o botão direito no CSV" },
    { "click": ".kn-menu-item:has-text('Mover para')" },
    { "waitFor": ".kn-palette[aria-label^='Mover']", "name": "o seletor de pasta" },
    { "screenshot": "mover-arquivo.png" },
    { "press": "Escape" },
    { "click": ".kn-tree-pop .kn-side-item[data-kind='file']:has-text('Relatório')", "button": "right" },
    { "click": ".kn-menu-item:has-text('Apagar')" },
    { "waitFor": ".kn-toast:has-text('Relatório.pdf')", "name": "o aviso com o Desfazer" },
    { "expectCount": ".kn-tree-pop .kn-side-item[data-kind='file'][data-type='pdf']", "count": 0, "name": "o PDF sai da árvore" },
    { "click": ".kn-toast button:has-text('Desfazer')", "name": "o Desfazer (o clique fora fecha a árvore)" },
    { "click": ".kn-crumb-bt", "name": "abre a árvore de novo" },
    { "waitFor": ".kn-tree-pop .kn-side-item[data-kind='file'][data-type='pdf']:has-text('Relatório')", "name": "o Desfazer devolve o PDF" }
  ]
}
