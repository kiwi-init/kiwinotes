    { "expectText": ".kn-file-title", "text": "plano.pdf", "name": "o nome do arquivo no topo" },
    { "screenshot": "01-pdf.png" },
    { "invoke": "notes.openPath", "args": { "path": "Feira.md" }, "name": "o clique numa nota do balão" },
    { "waitFor": ".kn-note-editor", "name": "a nota abre no editor" },
    { "expectCount": ".kn-file", "count": 0, "name": "o view de arquivo sai" },
