{
  "window": "hub",
  "size": "900x2600",
  "steps": [
    { "waitFor": ".kn-tab", "name": "o hub abre" },
    { "waitFor": "html[lang='en']", "name": "o app em inglês (T29271)" },
    { "click": "[role='tab'][data-section='settings']", "name": "vai para os Ajustes" },
    { "click": ".kn-prefs-item[data-topic=agent]", "name": "o assunto Agente" },
    { "waitFor": ".kn-section:has(h2:text-is('Agent'))", "name": "a seção Agent" },
    { "expectText": ".kn-row:has(.kn-row-label:text-is('Turn on the agent')) .kn-row-hint", "text": "On", "name": "ligar o agente, em inglês" },
    { "expectText": ".kn-row:has(.kn-row-label:text-is('Adapter')) .kn-row-hint", "text": "downloaded", "name": "o adaptador pronto" },
    { "waitFor": ".kn-row:has(.kn-row-label:text-is('Model')) select", "name": "o Modelo" },
    { "waitFor": ".kn-row:has(.kn-row-label:text-is('Saver mode'))", "name": "o modo econômico" },
    { "click": ".kn-prefs-topic[data-topic=agent] .kn-prefs-tab[data-tab=kiwi]", "name": "a aba Kiwi (spec #31754)" },
    { "waitFor": ".kn-row:has(.kn-row-label:text-is(\"Kiwi's color\"))", "name": "a cor do Kiwi" },
    { "expectCount": ".kn-row:has(.kn-row-label:text-is(\"Kiwi's color\")) [role=radio][aria-label='Original Prism']", "count": 1, "name": "as paletas em inglês" },
    { "click": ".kn-prefs-topic[data-topic=agent] .kn-prefs-tab[data-tab=voice]", "name": "a aba Voz (spec #31754)" },
    { "waitFor": ".kn-row:has(.kn-row-label:text-is('Kiwi talks'))", "name": "o Kiwi fala" },
    { "click": ".kn-prefs-topic[data-topic=agent] .kn-prefs-tab[data-tab=advanced]", "name": "a aba Avançado (spec #31754)" },
    { "waitFor": ".kn-agent-test .kn-row-label:text-is('Test')", "name": "o Testar" },
    { "click": ".kn-agent-test button:has-text('Test')", "name": "testa" },
    { "waitFor": ".kn-agent-test-text", "timeout": 20000, "name": "a resposta do agente falso" },
    { "waitFor": ".kn-section:has(h2:text-is('Agent usage'))", "timeout": 20000, "name": "o medidor em inglês" },
    { "waitFor": ".kn-row:has(.kn-row-label:text-is('Your subscription')) button:text-is('Refresh'):enabled", "timeout": 20000 },
    { "expectCount": "text=/Ligar o agente|Adaptador|O Kiwi fala|Modo econômico|O gasto do agente/", "count": 0, "name": "nenhum rótulo em português" },
    { "click": ".kn-prefs-topic[data-topic=agent] .kn-prefs-tab[data-tab=general]", "name": "a aba Geral (spec #31754)" },
    { "screenshot": "1-agent.png", "selector": ".kn-section:has(h2:text-is('Agent'))" },
    { "click": ".kn-prefs-topic[data-topic=agent] .kn-prefs-tab[data-tab=advanced]", "name": "a aba Avançado (spec #31754)" },
    { "screenshot": "2-usage.png", "selector": ".kn-section:has(h2:text-is('Agent usage'))" }
  ]
}
