{
  "window": "hub",
  "size": "900x1400",
  "steps": [
    { "waitFor": ".kn-tab", "name": "o hub abre" },
    { "click": ".kn-tab:has-text('Configurações')" },
    { "click": ".kn-prefs-item[data-topic=agent]", "name": "o assunto Agente" },
    { "click": ".kn-prefs-topic[data-topic=agent] .kn-prefs-tab[data-tab=voice]", "name": "a aba Voz (spec #31754)" },
    { "waitFor": ".kn-row:has(.kn-row-label:text-is('O Kiwi fala'))", "name": "a linha \"O Kiwi fala\", com o agente ligado" },
    { "expectCount": ".kn-row:has(.kn-row-label:text-is('O Kiwi fala')) [role=switch][aria-checked=true]", "count": 0, "name": "desligado por padrão" },
    { "expectCount": ".kn-row:has(.kn-row-label:text-is('A voz do Kiwi'))", "count": 0, "name": "desligado, sem a voz no disco, a linha da voz não aparece" },
    { "expectText": ".kn-row:has(.kn-row-label:text-is('O Kiwi fala'))", "text": "A voz roda neste Mac: nada sai dele.", "name": "o texto diz que a voz roda no Mac e nada sai dele" },
    { "invoke": "catVoice.status", "expect": { "phase": "off" }, "name": "abrir os Ajustes não baixa nada" },
    { "screenshot": "1-desligado.png", "selector": ".kn-row:has(.kn-row-label:text-is('O Kiwi fala'))" },

    { "click": ".kn-row:has(.kn-row-label:text-is('O Kiwi fala')) [role=switch]", "name": "ligar" },
    { "expectText": ".kn-row:has(.kn-row-label:text-is('A voz do Kiwi'))", "text": "Para falar, o Kiwi precisa do modelo e das vozes", "name": "ligado sem a voz: o tamanho e o botão" },
    { "expectText": ".kn-row:has(.kn-row-label:text-is('A voz do Kiwi')) button", "text": "Baixar a voz" },
    { "invoke": "agent.status", "expect": { "catSpeaks": true }, "name": "ligar grava o catSpeaks" },
    { "invoke": "catVoice.status", "expect": { "phase": "off" }, "name": "ligar não baixa: só o clique" },
    { "screenshot": "2-ligado.png", "selector": ".kn-row:has(.kn-row-label:text-is('A voz do Kiwi'))" },

    { "click": ".kn-row:has(.kn-row-label:text-is('A voz do Kiwi')) button:text-is('Baixar a voz')", "name": "o clique baixa" },
    { "expectText": ".kn-row:has(.kn-row-label:text-is('A voz do Kiwi'))", "text": "Baixando a voz:", "name": "o andamento" },
    { "expectText": ".kn-row:has(.kn-row-label:text-is('A voz do Kiwi')) button", "text": "Cancelar" },
    { "wait": 1200 },
    { "screenshot": "3-baixando.png", "selector": ".kn-row:has(.kn-row-label:text-is('A voz do Kiwi'))" },
    { "click": ".kn-row:has(.kn-row-label:text-is('A voz do Kiwi')) button:text-is('Cancelar')", "name": "cancelar no meio" },
    { "expectText": ".kn-row:has(.kn-row-label:text-is('A voz do Kiwi')) button", "text": "Baixar a voz", "name": "cancelado, o botão volta" },
    { "invoke": "catVoice.status", "expect": { "phase": "off" } },

    { "click": ".kn-row:has(.kn-row-label:text-is('A voz do Kiwi')) button:text-is('Baixar a voz')", "name": "baixar e desligar no meio" },
    { "expectText": ".kn-row:has(.kn-row-label:text-is('A voz do Kiwi'))", "text": "Baixando a voz:" },
    { "click": ".kn-row:has(.kn-row-label:text-is('O Kiwi fala')) [role=switch]", "name": "desligar no meio do download" },
    { "expectText": ".kn-row:has(.kn-row-label:text-is('A voz do Kiwi'))", "text": "O Kiwi está desligado", "name": "desligado, o download segue à vista" },
    { "invoke": "agent.status", "expect": { "catSpeaks": false } },
    { "expectText": ".kn-row:has(.kn-row-label:text-is('A voz do Kiwi')) button", "text": "Cancelar", "name": "com o Cancelar" },
    { "screenshot": "3b-desligado-baixando.png", "selector": ".kn-row:has(.kn-row-label:text-is('A voz do Kiwi'))" },
    { "click": ".kn-row:has(.kn-row-label:text-is('A voz do Kiwi')) button:text-is('Cancelar')", "name": "cancelar desligado" },
    { "expectCount": ".kn-row:has(.kn-row-label:text-is('A voz do Kiwi'))", "count": 0, "name": "cancelado e desligado, a linha some" },
    { "invoke": "catVoice.status", "expect": { "phase": "off" } },
    { "click": ".kn-row:has(.kn-row-label:text-is('O Kiwi fala')) [role=switch]", "name": "ligar de novo" },
    { "expectText": ".kn-row:has(.kn-row-label:text-is('A voz do Kiwi')) button", "text": "Baixar a voz" },
    { "invoke": "agent.status", "expect": { "catSpeaks": true } },

    { "click": ".kn-row:has(.kn-row-label:text-is('A voz do Kiwi')) button:text-is('Baixar a voz')", "name": "baixar de novo" },
    { "expectText": ".kn-row:has(.kn-row-label:text-is('A voz do Kiwi'))", "text": "Preparando a voz neste Mac", "timeout": 20000, "name": "ao terminar, o warmup do kiwi-voice" },
    { "screenshot": "4-preparando.png", "selector": ".kn-row:has(.kn-row-label:text-is('A voz do Kiwi'))" },
    { "expectText": ".kn-row:has(.kn-row-label:text-is('A voz do Kiwi'))", "text": "Pronta. A voz roda neste Mac", "timeout": 15000, "name": "pronta" },
    { "expectText": ".kn-row:has(.kn-row-label:text-is('A voz do Kiwi')) button", "text": "Remover a voz" },
    { "invoke": "catVoice.status", "expect": { "phase": "ready" } },
    { "screenshot": "5-pronta.png", "selector": ".kn-row:has(.kn-row-label:text-is('A voz do Kiwi'))" },

    {"expectText": ".kn-row:has(.kn-row-label:text-is('Idioma da voz')) [role=radio][aria-checked=true]", "text": "Português", "name": "quem nunca escolheu: a PT-1, e o idioma dela (#28142)"},
    {"expectText": ".kn-row:has(.kn-row-label:text-is('Kiwi PT-1'))", "text": "Leve, com sotaque brasileiro", "name": "o código e a descrição"},
    {"expectText": ".kn-row:has(.kn-row-label:text-is('Kiwi PT-1')) button[aria-pressed=true]", "text": "Escolhida", "name": "a padrão marcada"},
    {"expectCount": ".kn-row:has(.kn-row-label:text-is('Kiwi EN-1'))", "count": 0, "name": "só as vozes do idioma"},
    {"invoke": "catVoice.status", "expect": {"selected": "pt-a", "phase": "ready"}},
    {"screenshot": "5b-vozes.png", "selector": ".kn-section:has(.kn-row-label:text-is('O Kiwi fala'))"},
    {"click": ".kn-row:has(.kn-row-label:text-is('Kiwi PT-1')) button:text-is('Ouvir')", "name": "ouvir a PT-1"},
    {"expectText": ".kn-row:has(.kn-row-label:text-is('Kiwi PT-1')) button", "text": "Parar", "name": "enquanto toca, o Parar"},
    {"screenshot": "5c-ouvindo.png", "selector": ".kn-section:has(.kn-row-label:text-is('O Kiwi fala'))"},
    {"invoke": "catVoice.status", "expect": {"selected": "pt-a", "preview": "pt-a"}, "name": "ouvindo a PT-1"},
    {"expectText": ".kn-row:has(.kn-row-label:text-is('Kiwi PT-1')) button:first-child", "text": "Ouvir", "timeout": 15000, "name": "a prévia acaba e o botão volta"},
    {"click": ".kn-row:has(.kn-row-label:text-is('Idioma da voz')) [role=radio]:text-is('Inglês')", "name": "o inglês"},
    {"expectText": ".kn-row:has(.kn-row-label:text-is('Kiwi EN-1'))", "text": "Animada e divertida"},
    {"expectText": ".kn-row:has(.kn-row-label:text-is('Kiwi EN-2'))", "text": "Suave e fofa"},
    {"expectCount": ".kn-row:has(.kn-row-label:text-is('Kiwi PT-1'))", "count": 0, "name": "só as vozes do inglês"},
    {"click": ".kn-row:has(.kn-row-label:text-is('Kiwi EN-2')) button:text-is('Usar')", "name": "escolher a EN-2"},
    {"expectText": ".kn-row:has(.kn-row-label:text-is('Kiwi EN-2')) button[aria-pressed=true]", "text": "Escolhida"},
    {"invoke": "catVoice.status", "expect": {"selected": "en-b", "phase": "ready"}, "name": "trocar de voz grava e não baixa nada"},
    {"click": ".kn-row:has(.kn-row-label:text-is('Kiwi EN-1')) button:text-is('Ouvir')", "name": "ouvir a EN-1, que não é a escolhida"},
    {"expectText": ".kn-row:has(.kn-row-label:text-is('Kiwi EN-1')) button", "text": "Parar"},
    {"invoke": "catVoice.status", "expect": {"selected": "en-b", "preview": "en-a"}, "name": "ouvir não muda a escolhida"},
    {"expectText": ".kn-row:has(.kn-row-label:text-is('Kiwi EN-1')) button:first-child", "text": "Ouvir", "timeout": 15000},
    {"screenshot": "5d-ingles.png", "selector": ".kn-section:has(.kn-row-label:text-is('O Kiwi fala'))"},

    { "click": ".kn-row:has(.kn-row-label:text-is('O Kiwi fala')) [role=switch]", "name": "desligar" },
    { "expectText": ".kn-row:has(.kn-row-label:text-is('A voz do Kiwi'))", "text": "Baixada (", "name": "desligado com a voz no disco: dá para apagar" },
    { "invoke": "agent.status", "expect": { "catSpeaks": false } },
    { "screenshot": "6-desligado-baixada.png", "selector": ".kn-row:has(.kn-row-label:text-is('A voz do Kiwi'))" },
    { "click": ".kn-row:has(.kn-row-label:text-is('A voz do Kiwi')) button:text-is('Remover a voz')", "name": "remover" },
    { "expectCount": ".kn-row:has(.kn-row-label:text-is('A voz do Kiwi'))", "count": 0, "name": "removida, a linha some" },
    { "invoke": "catVoice.status", "expect": { "phase": "off" } }
  ]
}
