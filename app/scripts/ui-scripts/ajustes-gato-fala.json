{
  "window": "hub",
  "size": "900x1400",
  "steps": [
    { "waitFor": ".kn-tab", "name": "o hub abre" },
    { "click": ".kn-tab:has-text('Configurações')" },
    { "click": ".kn-prefs-item[data-topic=agent]", "name": "o assunto Agente" },
    { "waitFor": ".kn-row:has(.kn-row-label:text-is('O gato fala'))", "name": "a linha \"O gato fala\", com o agente ligado" },
    { "expectCount": ".kn-row:has(.kn-row-label:text-is('O gato fala')) [role=switch][aria-checked=true]", "count": 0, "name": "desligado por padrão" },
    { "expectCount": ".kn-row:has(.kn-row-label:text-is('A voz do gato'))", "count": 0, "name": "desligado, sem a voz no disco, a linha da voz não aparece" },
    { "expectText": ".kn-row:has(.kn-row-label:text-is('O gato fala'))", "text": "A voz roda neste Mac: nada sai dele.", "name": "o texto diz que a voz roda no Mac e nada sai dele" },
    { "invoke": "catVoice.status", "expect": { "phase": "off" }, "name": "abrir os Ajustes não baixa nada" },
    { "screenshot": "1-desligado.png", "selector": ".kn-row:has(.kn-row-label:text-is('O gato fala'))" },

    { "click": ".kn-row:has(.kn-row-label:text-is('O gato fala')) [role=switch]", "name": "ligar" },
    { "expectText": ".kn-row:has(.kn-row-label:text-is('A voz do gato'))", "text": "Para falar, o gato precisa do modelo de voz", "name": "ligado sem a voz: o tamanho e o botão" },
    { "expectText": ".kn-row:has(.kn-row-label:text-is('A voz do gato')) button", "text": "Baixar a voz" },
    { "invoke": "agent.status", "expect": { "catSpeaks": true }, "name": "ligar grava o catSpeaks" },
    { "invoke": "catVoice.status", "expect": { "phase": "off" }, "name": "ligar não baixa: só o clique" },
    { "screenshot": "2-ligado.png", "selector": ".kn-row:has(.kn-row-label:text-is('A voz do gato'))" },

    { "click": ".kn-row:has(.kn-row-label:text-is('A voz do gato')) button:text-is('Baixar a voz')", "name": "o clique baixa" },
    { "expectText": ".kn-row:has(.kn-row-label:text-is('A voz do gato'))", "text": "Baixando a voz:", "name": "o andamento" },
    { "expectText": ".kn-row:has(.kn-row-label:text-is('A voz do gato')) button", "text": "Cancelar" },
    { "wait": 1200 },
    { "screenshot": "3-baixando.png", "selector": ".kn-row:has(.kn-row-label:text-is('A voz do gato'))" },
    { "click": ".kn-row:has(.kn-row-label:text-is('A voz do gato')) button:text-is('Cancelar')", "name": "cancelar no meio" },
    { "expectText": ".kn-row:has(.kn-row-label:text-is('A voz do gato')) button", "text": "Baixar a voz", "name": "cancelado, o botão volta" },
    { "invoke": "catVoice.status", "expect": { "phase": "off" } },

    { "click": ".kn-row:has(.kn-row-label:text-is('A voz do gato')) button:text-is('Baixar a voz')", "name": "baixar de novo" },
    { "expectText": ".kn-row:has(.kn-row-label:text-is('A voz do gato'))", "text": "Preparando a voz neste Mac", "timeout": 20000, "name": "ao terminar, o warmup do kiwi-voice" },
    { "screenshot": "4-preparando.png", "selector": ".kn-row:has(.kn-row-label:text-is('A voz do gato'))" },
    { "expectText": ".kn-row:has(.kn-row-label:text-is('A voz do gato'))", "text": "Pronta. A voz roda neste Mac", "timeout": 15000, "name": "pronta" },
    { "expectText": ".kn-row:has(.kn-row-label:text-is('A voz do gato')) button", "text": "Remover a voz" },
    { "invoke": "catVoice.status", "expect": { "phase": "ready" } },
    { "screenshot": "5-pronta.png", "selector": ".kn-row:has(.kn-row-label:text-is('A voz do gato'))" },

    { "click": ".kn-row:has(.kn-row-label:text-is('O gato fala')) [role=switch]", "name": "desligar" },
    { "expectText": ".kn-row:has(.kn-row-label:text-is('A voz do gato'))", "text": "Baixada (", "name": "desligado com a voz no disco: dá para apagar" },
    { "invoke": "agent.status", "expect": { "catSpeaks": false } },
    { "screenshot": "6-desligado-baixada.png", "selector": ".kn-row:has(.kn-row-label:text-is('A voz do gato'))" },
    { "click": ".kn-row:has(.kn-row-label:text-is('A voz do gato')) button:text-is('Remover a voz')", "name": "remover" },
    { "expectCount": ".kn-row:has(.kn-row-label:text-is('A voz do gato'))", "count": 0, "name": "removida, a linha some" },
    { "invoke": "catVoice.status", "expect": { "phase": "off" } }
  ]
}
