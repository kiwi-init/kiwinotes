{
  "window": "notes",
  "steps": [
    {
      "invoke": "notes.create",
      "args": {
        "title": "Composer",
        "content": "# Título\n\nUm dois três **quatro**.\n"
      }
    },
    {
      "waitFor": ".kn-crumb-bt",
      "name": "a janela Notas abre"
    },
    {
      "press": "Meta+k"
    },
    {
      "type": "Composer"
    },
    {
      "waitFor": ".kn-palette .kn-palette-it:has-text('Composer')"
    },
    {
      "press": "Enter"
    },
    {
      "click": ".kn-note-editor .cm-rendered p:has-text('Um dois três')",
      "name": "clica no parágrafo"
    },
    {
      "press": "Home"
    },
    {
      "click": ".kn-composer-input",
      "name": "vai para o Composer (o editor perde o foco)"
    },
    {
      "type": "INSERIDO"
    },
    {
      "press": "Enter",
      "name": "o Composer põe o texto no cursor da nota"
    },
    {
      "waitFor": ".kn-note-editor .cm-rendered p:has-text('INSERIDOUm dois três')",
      "name": "o bloco renderizado já tem o texto novo (o CodeMirror reaproveitou o DOM)"
    },
    {
      "click": ".kn-note-editor .cm-rendered strong:has-text('quatro')",
      "name": "clica no meio do quatro"
    },
    {
      "type": "Z"
    },
    {
      "waitFor": ".kn-note-editor .cm-line:has-text('INSERIDOUm dois três **quaZtro**.')",
      "name": "o Z entra onde foi o clique, e não 8 caracteres antes (review do T2983)"
    }
  ]
}