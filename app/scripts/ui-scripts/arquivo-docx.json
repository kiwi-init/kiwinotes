{
  "window": "notes",
  "steps": [
    { "waitFor": ".kn-crumb-bt", "name": "a janela Notas abre (antes, no cofre: Docs/proposta.docx, a cópia de test/fixtures/files/proposta.docx; Docs/bomba.docx, o mesmo com 30 MB de texto no document.xml; Docs/mentirosa.docx, a bomba com o tamanho declarado trocado para 5 KB; e uma nota)" },
    { "click": ".kn-crumb-bt", "name": "abre a árvore" },
    { "click": ".kn-tree-pop .kn-side-item[data-kind='folder']:has-text('Docs')", "name": "abre a pasta Docs" },
    { "click": ".kn-tree-pop .kn-side-item[data-kind='file']:has-text('proposta')", "name": "clica no docx" },
    { "waitFor": ".kn-file[data-state='ready'] .docx-page", "timeout": 30000, "name": "o docx abre nas Notas, em páginas (o motor do T21151)" },
    { "expectText": ".kn-file-title", "text": "proposta.docx" },
    { "expectText": ".kn-file-pdf-page", "text": "1 página" },
    { "expectText": ".docx-page", "text": "Proposta de mudança", "name": "o título" },
    { "expectText": ".docx-page", "text": "R$ 2.400,00", "name": "a tabela" },
    { "expectCount": ".docx-page img.docx-drawing-image[src^='blob:']", "count": 1, "name": "a imagem, de dentro do próprio documento" },
    { "expectText": ".docx-page", "text": "& o orçamento <aprovado>.", "name": "o texto escapado aparece como texto" },
    { "expectCount": ".docx-page a.docx-hyperlink[href='https://example.com/fornecedor']", "count": 1, "name": "o link de fora segue link" },
    { "expectCount": ".docx-page a[href^='javascript']", "count": 0, "name": "o link javascript: do documento não vira link" },
    { "expectText": ".docx-page", "text": "um link perigoso", "name": "o texto dele fica" },
    { "screenshot": "01-docx.png" },
    { "click": ".kn-file-docx-scroll", "position": { "x": 20, "y": 120 }, "name": "um clique na área das páginas" },
    { "press": "Meta+f", "name": "⌘F vai para a busca" },
    { "type": "orcamento" },
    { "waitFor": ".kn-file-docx-mark[data-current]", "name": "acha sem acento e marca na página" },
    { "expectText": ".kn-file-pdf-count", "text": "1 de 2" },
    { "press": "Enter" },
    { "expectText": ".kn-file-pdf-count", "text": "2 de 2" },
    { "screenshot": "02-docx-busca.png" },
    { "press": "Escape" },
    { "expectCount": ".kn-file-docx-mark", "count": 0, "name": "o Esc limpa as marcas" },
    { "click": ".kn-crumb-bt", "name": "abre a árvore" },
    { "click": ".kn-tree-pop .kn-side-item[data-kind='file']:has-text('bomba')", "name": "clica num docx de 33 KB que descompacta para 30 MB" },
    { "waitFor": ".kn-file[data-state='ready'] .kn-file-notice:has-text('grande demais')", "name": "recusado antes do motor, sem travar a janela" },
    { "expectCount": ".docx-page", "count": 0, "name": "e o motor do docx de antes foi solto" },
    { "screenshot": "03-bomba.png" },
    { "click": ".kn-crumb-bt", "name": "abre a árvore" },
    { "click": ".kn-tree-pop .kn-side-item[data-kind='file']:has-text('mentirosa')", "name": "a mesma bomba, mas o zip declara 5 KB (rodada 2)" },
    { "waitFor": ".kn-file[data-state='ready'] .kn-file-notice:has-text('grande demais')", "name": "também recusada antes do motor" },
    { "expectCount": ".docx-page", "count": 0 },
    { "click": ".kn-crumb-bt", "name": "abre a árvore" },
    { "click": ".kn-tree-pop .kn-side-item[data-kind='note']", "name": "clicar numa nota volta para o editor" },
    { "waitFor": ".kn-note-editor .cm-content" },
    { "expectCount": ".kn-file", "count": 0 }
  ]
}
