{
 "window": "notes",
 "steps": [
  {
   "invoke": "notes.create",
   "args": {
    "title": "Estresse",
    "content": "# Teste do menu\n\nUm parágrafo qualquer[^1].\n\nOutro parágrafo.\n\n[^1]: A primeira.\n"
   }
  },
  {
   "waitFor": ".kn-crumb-bt"
  },
  {
   "press": "Meta+k"
  },
  {
   "type": "Estresse"
  },
  {
   "waitFor": ".kn-palette .kn-palette-it:has-text('Estresse')"
  },
  {
   "press": "Enter"
  },
  {
   "waitFor": ".kn-note-editor .cm-rendered a[href^='kiwi-footnote-def:']"
  },
  {
   "click": ".kn-note-editor .cm-rendered p:has-text('Outro parágrafo')",
   "name": "2: o cursor no parágrafo"
  },
  {
   "click": ".kn-note-editor .cm-line:has-text('Outro parágrafo')",
   "button": "right"
  },
  {
   "hover": "[role=menuitem]:has-text('Inserir')"
  },
  {
   "click": "[role=menuitem]:has-text('Nota de rodapé')"
  },
  {
   "type": "Menu 2."
  },
  {
   "waitFor": ".kn-note-editor .cm-line:has-text('[^2]: Menu 2.')",
   "timeout": 2500,
   "name": "2: o texto entra na definição nova"
  },
  {
   "press": "Escape"
  },
  {
   "click": ".kn-note-editor .cm-rendered p:has-text('Outro parágrafo')",
