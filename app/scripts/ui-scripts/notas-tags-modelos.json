{
  "window": "hub",
  "steps": [
    { "waitFor": ".kn-tab[aria-selected='true']:has-text('Notas')", "name": "o hub abre nas Notas" },
    { "invoke": "notes.create", "args": { "folder": "Modelos", "title": "Ata", "content": "---\ntags: [ata]\n---\n# {{title}}\n\nData: {{date:DD/MM/AAAA}}\n" } },
    { "invoke": "notes.create", "args": { "title": "Kiwi", "content": "Plano do #projeto/kiwi e do `#codigo`.\n" } },
    { "invoke": "notes.create", "args": { "title": "Site", "content": "Sobre o #Projeto/site.\n" } },
    { "click": ".kn-crumb-bt", "name": "abre a árvore" },
    { "waitFor": ".kn-tree-pop .kn-side-item[data-kind='tag']:has-text('#projeto')", "name": "a seção Tags, com #projeto" },
    { "expectText": ".kn-tree-pop .kn-side-item[data-kind='tag']:has-text('#projeto') .kn-side-count", "text": "2", "name": "duas notas, sem diferença de maiúscula" },
    { "expectCount": ".kn-tree-pop .kn-side-item[data-kind='tag']:has-text('#codigo')", "count": 0, "name": "tag dentro de código não conta" },
    { "screenshot": "tags-arvore.png" },
    { "click": ".kn-tree-pop .kn-side-item[data-kind='tag']:has-text('#kiwi')", "name": "um clique na tag" },
    { "waitFor": ".kn-palette .kn-palette-it:has-text('Kiwi')", "name": "abre o ⌘K com as notas da tag" },
    { "expectCount": ".kn-palette .kn-palette-it", "count": 1, "name": "só a com #projeto/kiwi, sem o Criar" },
    { "press": "Enter", "name": "abre a nota" },
    { "waitFor": ".kn-note-editor .cm-tag[data-tag='projeto/kiwi']", "name": "o editor destaca a #tag" },
    { "expectCount": ".kn-note-editor .cm-tag[data-tag='codigo']", "count": 0, "name": "e não a de dentro do código" },
    { "screenshot": "tags-nota.png" },
    { "click": ".kn-note-editor .cm-tag[data-tag='projeto/kiwi']", "name": "clique na #tag do texto" },
    { "waitFor": ".kn-palette .kn-palette-it:has-text('Kiwi')", "name": "abre a busca por ela" },
    { "press": "Escape" },
    { "press": "Meta+k" },
    { "type": "modelo" },
    { "waitFor": ".kn-palette .kn-palette-it:has-text('Nova nota a partir de modelo')", "name": "o comando no ⌘K" },
    { "click": ".kn-palette .kn-palette-it:has-text('Nova nota a partir de modelo')" },
    { "waitFor": ".kn-palette[aria-label*='a partir de'] .kn-palette-it:has-text('Ata')", "name": "a lista dos modelos da pasta Modelos" },
    { "press": "Enter", "name": "escolhe o modelo" },
    { "waitFor": ".kn-title", "name": "a nota nova abre" },
    { "expectText": ".kn-note-editor", "text": "Data: ", "name": "com o texto do modelo" },
    { "expectCount": ".kn-note-editor:has-text('{{')", "count": 0, "name": "e as variáveis trocadas" },
    { "expectCount": ".kn-meta-bt:has-text('#ata')", "count": 1, "name": "a tag do frontmatter do modelo na meta" },
    { "screenshot": "modelo-nota.png" }
  ]
}
