{
  "window": "notes",
  "steps": [
    {
      "invoke": "notes.create",
      "args": {
        "folder": "",
        "title": "Inbox",
        "content": "Coisas soltas.\n"
      }
    },
    {
      "invoke": "notes.create",
      "args": {
        "folder": "Projetos",
        "title": "Plano",
        "content": "O plano.\n"
      }
    },
    {
      "waitFor": ".kn-crumb-bt",
      "name": "a janela Notas abre"
    },
    {
      "click": ".kn-crumb-bt"
    },
    {
      "waitFor": ".kn-tree-pop .kn-side-new[data-new='folder'][title='Nova pasta na raiz']",
      "name": "com a Inbox (na raiz) aberta, o botão diz que cria na raiz"
    },
    {
      "click": ".kn-tree-pop .kn-side-new[data-new='folder']",
      "name": "+ Pasta"
    },
    {
      "waitFor": ".kn-tree-pop .kn-side-rename",
      "name": "a pasta nova já entra em renomear"
    },
    {
      "fill": ".kn-tree-pop .kn-side-rename",
      "text": "Ideias"
    },
    {
      "press": "Enter"
    },
    {
      "waitFor": ".kn-tree-pop .kn-side-item[data-kind='folder'][data-path='Ideias']",
      "name": "a pasta Ideias foi criada na raiz"
    },
    {
      "expectCount": ".kn-tree-pop .kn-side-item[data-kind='folder'][data-selected]",
      "count": 0,
      "name": "spec #19265: a pasta nova não vira a escolhida"
    },
    {
      "expectCount": ".kn-tree-pop .kn-side-new[data-new='folder'][title='Nova pasta na raiz']",
      "count": 1,
      "name": "o + Pasta continua criando na raiz"
    },
    {
      "click": ".kn-tree-pop .kn-side-new[data-new='folder']",
      "name": "+ Pasta de novo"
    },
    {
      "waitFor": ".kn-tree-pop .kn-side-rename[data-fresh]",
      "name": "a pasta nova vem realçada, com o nome em foco"
    },
    {
      "screenshot": "pasta-nova-realcada.png"
    },
    {
      "fill": ".kn-tree-pop .kn-side-rename",
      "text": "Rascunhos"
    },
    {
      "press": "Enter"
    },
    {
      "waitFor": ".kn-tree-pop .kn-side-item[data-kind='folder'][data-path='Rascunhos']",
      "name": "dois cliques seguidos: Rascunhos nasce na raiz, irmã de Ideias"
    },
    {
      "expectCount": ".kn-tree-pop .kn-side-item[data-kind='folder'][data-path^='Ideias/']",
      "count": 0,
      "name": "nada aninhado dentro de Ideias"
    },
    {
      "wait": 400,
      "name": "passa a conferência de vista (250 ms)"
    },
    {
      "expectCount": ".kn-toast",
      "count": 0,
      "name": "sem o aviso Pasta criada: a pasta ficou à vista e só mudou de nome"
    },
    {
      "click": ".kn-tree-pop .kn-side-item[data-kind='folder']:has-text('Projetos')",
      "name": "escolhe Projetos"
    },
    {
      "waitFor": ".kn-tree-pop .kn-side-new[data-new='note'][aria-label='Nova nota em Projetos']"
    },
    {
      "click": ".kn-tree-pop .kn-side-search",
      "name": "o teclado na árvore: a busca"
    },
    {
      "press": "ArrowDown",
      "name": "↓ entra na 1ª linha"
    },
    {
      "press": "Escape",
      "name": "Esc numa linha da árvore"
    },
    {
      "waitFor": ".kn-tree-pop .kn-side-new[data-new='folder'][title='Nova pasta na raiz']",
      "name": "spec #19265: o Esc escolhe a raiz"
    },
    {
      "expectCount": ".kn-tree-pop[data-open]",
      "count": 1,
      "name": "e a árvore segue aberta (com a raiz já escolhida, o Esc fecha, como antes)"
    },
    {
      "click": ".kn-tree-pop .kn-side-item[data-kind='folder']:has-text('Projetos')",
      "name": "escolhe Projetos"
    },
    {
      "waitFor": ".kn-tree-pop .kn-side-new[data-new='folder'][title='Nova pasta em Projetos']"
    },
    {
      "click": ".kn-tree-pop .kn-side-root-bt",
      "name": "clica na linha da raiz, no topo"
    },
    {
      "waitFor": ".kn-tree-pop .kn-side-new[data-new='folder'][title='Nova pasta na raiz']",
      "name": "spec #19265: o clique na raiz a escolhe"
    },
    {
      "expectCount": ".kn-tree-pop .kn-side-root-bt[data-selected]",
      "count": 1,
      "name": "e ela fica destacada como destino"
    },
    {
      "expectCount": ".kn-tree-pop [data-root='open']",
      "count": 0,
      "name": "sem abrir o menu Abrir pasta… (rodada 2)"
    },
    {
      "screenshot": "raiz-escolhida.png"
    },
    {
      "click": ".kn-tree-pop .kn-side-root-toggle",
      "name": "a seta da raiz"
    },
    {
      "waitFor": ".kn-tree-pop [data-root='open']",
      "name": "abre o Abrir pasta… e as recentes"
    },
    {
      "click": ".kn-tree-pop .kn-side-root-toggle",
      "name": "e fecha de novo"
    },
    {
      "expectCount": ".kn-tree-pop [data-root='open']",
      "count": 0
    },
    {
      "click": ".kn-tree-pop .kn-side-item[data-kind='folder']:has-text('Projetos')",
      "name": "escolhe Projetos de novo"
    },
    {
      "waitFor": ".kn-tree-pop .kn-side-new[data-new='note'][aria-label='Nova nota em Projetos']"
    },
    {
      "screenshot": "botoes-criar.png"
    },
    {
      "click": ".kn-tree-pop .kn-side-new[data-new='note']",
      "name": "+ Nota em Projetos"
    },
    {
      "waitFor": ".kn-crumb-bt:has-text('Projetos')",
      "name": "a nota nova abre dentro de Projetos"
    },
    {
      "expectText": ".kn-title",
      "text": "",
      "name": "com o título"
    },
    {
      "click": ".kn-crumb-bt"
    },
    {
      "waitFor": ".kn-tree-pop .kn-side-item[data-kind='note']:has-text('Sem título')",
      "name": "a nota nova está na árvore"
    },
    {
      "expectCount": ".kn-tree-pop .kn-side-new[data-new='folder'][title='Nova pasta em Projetos']",
      "count": 1,
      "name": "com a nota aberta, a pasta dela é a escolhida"
    },
    {
      "click": ".kn-tree-pop .kn-side-new[data-new='folder']",
      "name": "+ Pasta dentro de Projetos"
    },
    {
      "waitFor": ".kn-tree-pop .kn-side-rename"
    },
    {
      "press": "Escape"
    },
    {
      "waitFor": ".kn-tree-pop .kn-side-item[data-kind='folder'][data-path='Projetos/Nova pasta']",
      "name": "a subpasta nova fica com o nome padrão, dentro de Projetos"
    },
    {
      "expectCount": ".kn-tree-pop .kn-side-new[data-new='folder'][title='Nova pasta em Projetos']",
      "count": 1,
      "name": "e Projetos continua a escolhida"
    },
    {
      "click": ".kn-tree-pop .kn-side-item[data-kind='folder'][data-path='Ideias']",
      "button": "right",
      "name": "o menu de Ideias"
    },
    {
      "click": ".kn-menu-item:has-text('Nova pasta ao lado')",
      "name": "spec #19265: Nova pasta ao lado"
    },
    {
      "waitFor": ".kn-tree-pop .kn-side-rename[data-fresh]"
    },
    {
      "press": "Escape"
    },
    {
      "waitFor": ".kn-tree-pop .kn-side-item[data-kind='folder'][data-path='Nova pasta']",
      "name": "nasce na raiz, ao lado de Ideias, não dentro"
    },
    {
      "screenshot": "botoes-criar-depois.png"
    }
  ]
}
