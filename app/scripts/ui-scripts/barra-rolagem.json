{
  "window": "settings",
  "steps": [
    { "waitFor": ".kn-content", "name": "os Ajustes abrem" },
    { "expectCount": ".kn-scrollbar.on", "count": 0, "name": "parado, não tem barra nenhuma na tela" },
    { "scroll": ".kn-content", "y": 300, "name": "rola os Ajustes com a roda" },
    { "waitFor": ".kn-scrollbar-y.on", "name": "o polegar fino aparece enquanto rola" },
    { "screenshot": "barra-rolagem-rolando.png" },
    { "hover": ".kn-scrollbar-y.on", "name": "mouse no polegar" },
    { "wait": 1200, "name": "passa o tempo de sumir com o mouse em cima" },
    { "expectCount": ".kn-scrollbar-y.on", "count": 1, "name": "com o mouse em cima, ele fica (e engrossa)" },
    { "screenshot": "barra-rolagem-hover.png" },
    { "hover": ".kn-content h2, .kn-content", "name": "o mouse sai do polegar" },
    { "waitFor": ".kn-scrollbar.on", "state": "detached", "timeout": 3000, "name": "e ele some sozinho logo depois" },
    { "screenshot": "barra-rolagem-parada.png" }
  ]
}
