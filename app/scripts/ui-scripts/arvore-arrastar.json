{
  "window": "notes",
  "steps": [
    { "invoke": "notes.create", "args": { "folder": "Projetos", "title": "Plano", "content": "# Plano\n\nVer ![[dados.csv]].\n" } },
    { "invoke": "notes.create", "args": { "folder": "Ideias", "title": "Lista", "content": "# Lista\n" } },
    { "invoke": "notes.create", "args": { "title": "Leia-me", "content": "# Leia-me\n" } },
    { "invoke": "files.create", "args": { "folder": "Projetos", "name": "dados.csv", "base64": "YSxiCjEsMgo=" } },
    { "waitFor": ".kn-crumb-bt", "name": "a janela Notas abre" },
    { "click": ".kn-crumb-bt", "name": "abre a árvore" },
    { "click": ".kn-tree-pop .kn-side-item[data-kind='folder']:has-text('Projetos')", "name": "abre a pasta Projetos" },
    { "waitFor": ".kn-tree-pop .kn-side-item[data-kind='file']:has-text('dados')" },
    { "dragTo": ".kn-tree-pop .kn-side-item[data-kind='note']:has-text('Leia-me')", "from": ".kn-tree-pop .kn-side-item[data-kind='note']:has-text('Plano')", "hold": true, "name": "arrasta o Plano por cima de uma nota da raiz" },
    { "waitFor": ".kn-tree-pop .kn-side-rootdrop[data-drop]", "name": "a faixa Raiz aparece e fica destacada" },
    { "screenshot": "raiz.png" },
    { "dragTo": ".kn-tree-pop .kn-side-item[data-kind='folder']:has-text('Ideias')", "at": 0.5, "hold": true, "name": "no meio da pasta Ideias" },
    { "expectCount": ".kn-tree-pop .kn-side-item[data-kind='folder'][data-drop]:has-text('Ideias')", "count": 1, "name": "a pasta Ideias fica destacada" },
    { "expectCount": ".kn-tree-pop .kn-side-rootdrop[data-drop]", "count": 0 },
    { "screenshot": "pasta.png" },
    { "dragTo": ".kn-tree-pop .kn-side-item[data-kind='folder']:has-text('Ideias')", "at": 0.1, "name": "solta na borda de cima da Ideias: entre duas pastas da raiz" },
    { "waitFor": ".kn-tree-pop .kn-side-item[data-kind='note']:has-text('Plano')" },
    { "invoke": "notes.get", "args": { "path": "Plano.md" }, "expect": { "content": "# Plano\n\nVer ![[dados.csv]].\n" }, "name": "o Plano foi para a raiz" },
    { "expectCount": ".kn-tree-pop .kn-side-rootdrop", "count": 0, "name": "a faixa sai quando solta" },
    { "dragTo": ".kn-tree-pop .kn-side-item[data-kind='folder']:has-text('Ideias')", "from": ".kn-tree-pop .kn-side-item[data-kind='file']:has-text('dados')", "at": 0.5, "name": "o CSV no meio da Ideias: vai para dentro" },
    { "invoke": "notes.get", "args": { "path": "Plano.md" }, "expect": { "content": "# Plano\n\nVer ![[dados.csv]].\n" }, "name": "o link pelo nome continua achando" },
    { "click": ".kn-tree-pop .kn-side-item[data-kind='folder']:has-text('Ideias')", "name": "abre a Ideias" },
    { "waitFor": ".kn-tree-pop .kn-side-item[data-kind='file']:has-text('dados')", "name": "o CSV está na Ideias" },
    { "dragTo": ".kn-tree-pop .kn-side-item[data-kind='note']:has-text('Lista')", "from": ".kn-tree-pop .kn-side-item[data-kind='folder']:has-text('Ideias')", "hold": true, "name": "uma pasta em cima de algo dela mesma" },
    { "expectCount": ".kn-tree-pop [data-drop]", "count": 0, "name": "nada destacado: não pode" },
    { "dragTo": ".kn-tree-pop .kn-side-item[data-kind='note']:has-text('Lista')", "name": "solta e nada muda" },
    { "invoke": "notes.get", "args": { "path": "Ideias/Lista.md" }, "expect": { "content": "# Lista\n" } }
  ]
}
