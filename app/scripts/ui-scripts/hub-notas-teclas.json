{
  "window": "hub",
  "steps": [
    {
      "waitFor": ".kn-tab",
      "name": "o hub abre"
    },
    {
      "invoke": "notes.create",
      "args": {
        "title": "Roteiro do hub",
        "content": "Uma nota para o roteiro.\n"
      },
      "name": "uma nota no vault (o roteiro não depende do vault ter nota)"
    },
    {
      "click": ".kn-crumb-bt",
      "name": "abre a árvore pelo caminho"
    },
    {
      "waitFor": ".kn-side-item:has-text('Roteiro do hub')",
      "name": "a nota aparece nas Notas"
    },
    {
      "press": "Escape",
      "name": "fecha a árvore"
    },
    {
      "click": ".kn-tab:has-text('Configurações')",
      "name": "vai para Configurações"
    },
    {
      "press": "Meta+n",
      "name": "⌘N com as Notas escondidas"
    },
    {
      "press": "Meta+k",
      "name": "⌘K com as Notas escondidas"
    },
    {
      "wait": 400
    },
    {
      "click": ".kn-tab:has-text('Notas')",
      "name": "volta para as Notas"
    },
    {
      "click": ".kn-crumb-bt",
      "name": "abre a árvore pelo caminho"
    },
    {
      "expectCount": ".kn-side-item:has-text('Sem título')",
      "count": 0,
      "name": "o ⌘N escondido não criou nota"
    },
    {
      "press": "Escape",
      "name": "fecha a árvore"
    },
    {
      "expectCount": ".kn-palette",
      "count": 0,
      "name": "o ⌘K escondido não abriu a busca"
    },
    {
      "click": ".kn-tab:has-text('Ditado')",
      "name": "vai para o Ditado"
    },
    {
      "press": "Meta+n",
      "name": "⌘N no Ditado"
    },
    {
      "press": "Meta+k",
      "name": "⌘K no Ditado"
    },
    {
      "wait": 400
    },
    {
      "click": ".kn-tab:has-text('Notas')",
      "name": "volta para as Notas de novo"
    },
    {
      "click": ".kn-crumb-bt",
      "name": "abre a árvore pelo caminho"
    },
    {
      "expectCount": ".kn-side-item:has-text('Sem título')",
      "count": 0,
      "name": "o ⌘N no Ditado não criou nota"
    },
    {
      "press": "Escape",
      "name": "fecha a árvore"
    },
    {
      "expectCount": ".kn-palette",
      "count": 0,
      "name": "o ⌘K no Ditado não abriu a busca"
    },
    {
      "press": "Meta+k",
      "name": "⌘K com as Notas na tela"
    },
    {
      "waitFor": ".kn-palette",
      "name": "a busca abre"
    },
    {
      "click": ".kn-tab:has-text('Ditado')",
      "name": "troca de seção com a busca aberta"
    },
    {
      "click": ".kn-tab:has-text('Notas')",
      "name": "volta para as Notas"
    },
    {
      "expectCount": ".kn-palette",
      "count": 0,
      "name": "a busca fechou ao sair das Notas"
    },
    {
      "press": "Meta+n",
      "name": "⌘N com as Notas na tela"
    },
    {
      "expectText": ".kn-title",
      "text": "Sem título",
      "name": "cria e abre a nota nova"
    },
    {
      "screenshot": "hub-notas-depois.png"
    }
  ]
}
