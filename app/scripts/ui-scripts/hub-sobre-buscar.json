{
  "window": "hub",
  "steps": [
    { "waitFor": ".kn-tab", "name": "o hub abre" },
    { "click": ".kn-tab:has-text('Configurações')", "name": "vai para Configurações" },
    { "click": ".kn-prefs-item[data-topic=about]", "name": "e para o Sobre" },
    { "expectText": ".kn-about-band .kn-about-line", "text": "Você está na última versão", "name": "com o atualizador de mentira, a última checagem" },
    { "expectText": ".kn-about-check .kn-row-label", "text": "Buscar atualizações", "name": "o interruptor fica embaixo da faixa (T25110)" },
    { "waitFor": ".kn-about-check [role=switch][aria-checked=true]", "name": "ligado por padrão" },
    { "expectText": ".kn-about-check .kn-row-hint", "text": "Desligado, o Kiwi Notes não faz nenhum pedido para isso." },
    { "click": ".kn-about-check [role=switch]", "name": "desliga" },
    { "waitFor": ".kn-about-check [role=switch][aria-checked=false]" },
    { "waitFor": ".kn-about-band[data-state=off]", "name": "a faixa passa a desligada na hora, sem reiniciar" },
    { "expectText": ".kn-about-band .kn-about-detail", "text": "O Kiwi Notes não procura versão nova nem aparência nova." },
    { "expectCount": ".kn-about-band button", "count": 0, "name": "e sem botão que vá à rede" },
    { "screenshot": "hub-sobre-buscar-desligado.png" },
    { "click": ".kn-about-check [role=switch]", "name": "liga de novo" },
    { "waitFor": ".kn-about-check [role=switch][aria-checked=true]" },
    { "waitFor": ".kn-about-band[data-state=idle]", "name": "e a faixa volta" },
    { "expectText": ".kn-about-band .kn-about-line", "text": "Você está na última versão" },
    { "screenshot": "hub-sobre-buscar-ligado.png" }
  ]
}
