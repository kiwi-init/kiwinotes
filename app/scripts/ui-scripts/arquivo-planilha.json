{
  "window": "notes",
  "steps": [
    { "waitFor": ".kn-crumb-bt", "name": "a janela Notas abre (antes, no cofre: Docs/vendas.xlsx, a cópia de test/fixtures/files/vendas.xlsx; Docs/enorme.xlsx, 800 células de 32 mil letras; e uma nota)" },
    { "click": ".kn-crumb-bt", "name": "abre a árvore" },
    { "click": ".kn-tree-pop .kn-side-item[data-kind='folder']:has-text('Docs')", "name": "abre a pasta Docs" },
    { "click": ".kn-tree-pop .kn-side-item[data-kind='file']:has-text('vendas')", "name": "clica no xlsx" },
    { "waitFor": ".kn-file[data-state='ready'] .kn-file-table", "timeout": 15000, "name": "a planilha abre nas Notas" },
    { "expectText": ".kn-file-title", "text": "vendas.xlsx" },
    { "expectCount": ".kn-file-sheet-tab", "count": 2, "name": "as 2 abas visíveis" },
    { "expectText": ".kn-file-sheet-tab[aria-selected='true']", "text": "Resumo", "name": "a primeira aberta" },
    { "expectText": ".kn-file-sheet-note", "text": "1 aba escondida", "name": "o aviso da aba escondida no Excel" },
    { "expectCount": ".kn-file-table thead th[scope='col']", "count": 5, "name": "as colunas com a letra, como na planilha" },
    { "expectText": ".kn-file-table thead", "text": "ABCDE" },
    { "expectText": ".kn-file-table tbody tr:nth-child(2)", "text": "R$ 2.099,40", "name": "o resultado guardado da fórmula, com a moeda e os separadores do sistema (pt-BR no headless)" },
    { "expectText": ".kn-file-table tbody tr:nth-child(2)", "text": "03/11/2026", "name": "a data formatada" },
    { "expectText": ".kn-file-table tbody tr:nth-child(5)", "text": "R$ 3.390,40", "name": "a soma" },
    { "expectText": ".kn-file-table-foot", "text": "5 linhas, 5 colunas" },
    { "screenshot": "01-planilha.png" },
    { "click": ".kn-file-sheet-tab:has-text('Metas')", "name": "troca de aba" },
    { "expectText": ".kn-file-sheet-tab[aria-selected='true']", "text": "Metas" },
    { "expectText": ".kn-file-table tbody", "text": "31,3%", "name": "a porcentagem, com a vírgula do sistema" },
    { "expectText": ".kn-file-table-foot", "text": "2 linhas, 2 colunas" },
    { "screenshot": "02-aba.png" },
    { "click": ".kn-crumb-bt", "name": "abre a árvore" },
    { "click": ".kn-tree-pop .kn-side-item[data-kind='file']:has-text('enorme')", "name": "uma planilha de poucos KB que abre em 25 MB de texto" },
    { "waitFor": ".kn-file-notice:has-text('grande demais')", "name": "recusada antes do SheetJS" },
    { "click": ".kn-crumb-bt", "name": "abre a árvore" },
    { "click": ".kn-tree-pop .kn-side-item[data-kind='note']", "name": "clicar numa nota volta para o editor" },
    { "waitFor": ".kn-note-editor .cm-content" },
    { "expectCount": ".kn-file", "count": 0 }
  ]
}
