{
  "window": "notes",
  "size": "1180x900",
  "steps": [
    {
      "invoke": "notes.create",
      "args": {
        "title": "Operações de tabela",
        "content": "# Operações de tabela\n\n| Nome | Valor |\n| :--- | ---: |\n| Bia | 10 |\n| Ana | 2 |\n| Céu \\| mar | 30 |\n\nFim.\n"
      }
    },
    {
      "invoke": "notes.create",
      "args": {
        "title": "Outra nota",
        "content": "# Outra nota\n\nTexto da outra.\n"
      },
      "name": "uma segunda nota, para a paleta abrir no fim"
    },
    {
      "waitFor": ".kn-crumb-bt"
    },
    {
      "press": "Meta+k"
    },
    {
      "type": "Operações de tabela"
    },
    {
      "waitFor": ".kn-palette-it:has-text('Operações de tabela')"
    },
    {
      "press": "Enter"
    },
    {
      "waitFor": ".cm-md-table td:has-text('Bia')"
    },
    {
      "click": ".cm-md-table td:has-text('Bia')",
      "button": "right"
    },
    {
      "waitFor": ".kn-menu:not([aria-label]) > .kn-menu-item:has-text('Tabela')"
    },
    {
      "hover": ".kn-menu:not([aria-label]) > .kn-menu-item:has-text('Tabela')"
    },
    {
      "waitFor": "[role=menu][aria-label='Tabela']"
    },
    {
      "hover": "[aria-label='Tabela'] > .kn-menu-item:has-text('Linha')"
    },
    {
      "waitFor": "[role=menu][aria-label='Linha']"
    },
    {
      "expectCount": "[aria-label='Linha'] .kn-menu-item:has-text('Duplicar linha') .kn-menu-hint",
      "count": 0
    },
    {
      "screenshot": "01-menu-linha.png"
    },
    {
      "click": "[aria-label='Tabela'] > .kn-menu-item:has-text('Linha')"
    },
    {
      "press": "End"
    },
    {
      "press": "ArrowUp"
    },
    {
      "press": "Enter",
      "name": "duplica a linha pelo teclado do menu, sem atalho global"
    },
    {
      "expectCount": ".cm-md-table tbody td:has-text('Bia')",
      "count": 2,
      "name": "a tabela segue desenhada depois do menu (T19814)"
    },
    {
      "expectCount": ".cm-line:has-text('| Bia')",
      "count": 0
    },
    {
      "click": ".cm-md-table tbody tr:nth-child(2) td:first-child",
      "name": "o clique abre só a célula"
    },
    {
      "waitFor": ".cm-md-table td.cm-md-table-editing .cm-md-table-input:focus"
    },
    {
      "expectCount": ".cm-md-table",
      "count": 1
    },
    {
      "press": "Meta+Alt+ArrowDown",
      "name": "os atalhos da tabela valem dentro da célula"
    },
    {
      "waitFor": ".cm-md-table tbody tr:nth-child(2) td:first-child:has-text('Ana')"
    },
    {
      "waitFor": ".cm-md-table tbody tr:nth-child(3) td.cm-md-table-editing:first-child"
    },
    {
      "press": "Meta+Alt+Shift+D"
    },
    {
      "press": "Meta+Alt+e"
    },
    {
      "press": "Escape",
      "name": "o Esc fecha a célula"
    },
    {
      "expectCount": ".cm-md-table-input",
      "count": 0
    },
    {
      "expectCount": ".cm-md-table th",
      "count": 3
    },
    {
      "waitFor": ".cm-md-table th:nth-child(2)[style*='center']"
    },
    {
      "click": ".cm-md-table th:nth-child(2)",
      "button": "right"
    },
    {
      "waitFor": ".kn-menu:not([aria-label]) > .kn-menu-item:has-text('Tabela')"
    },
    {
      "hover": ".kn-menu:not([aria-label]) > .kn-menu-item:has-text('Tabela')"
    },
    {
      "waitFor": "[role=menu][aria-label='Tabela']"
    },
    {
      "hover": "[aria-label='Tabela'] > .kn-menu-item:has-text('Coluna')"
    },
    {
      "waitFor": "[role=menu][aria-label='Coluna']"
    },
    {
      "screenshot": "02-menu-coluna.png"
    },
    {
      "click": "[aria-label='Coluna'] > .kn-menu-item:has-text('Mover à direita')"
    },
    {
      "waitFor": ".cm-md-table th:nth-child(3)[style*='center']"
    },
    {
      "click": ".cm-md-table tbody tr:first-child td:nth-child(2)",
      "button": "right"
    },
    {
      "waitFor": ".kn-menu:not([aria-label]) > .kn-menu-item:has-text('Tabela')"
    },
    {
      "hover": ".kn-menu:not([aria-label]) > .kn-menu-item:has-text('Tabela')"
    },
    {
      "waitFor": "[role=menu][aria-label='Tabela']"
    },
    {
      "hover": "[aria-label='Tabela'] > .kn-menu-item:has-text('Ordenar pela coluna')"
    },
    {
      "waitFor": "[role=menu][aria-label='Ordenar pela coluna']"
    },
    {
      "screenshot": "03-menu-ordenar.png"
    },
    {
      "click": "[aria-label='Ordenar pela coluna'] > .kn-menu-item:has-text('Crescente')"
    },
    {
      "expectText": ".cm-md-table tbody tr:first-child td:first-child",
      "text": "Ana"
    },
    {
      "expectText": ".cm-md-table tbody tr:first-child td:nth-child(2)",
      "text": "2"
    },
    {
      "screenshot": "04-ordenada.png"
    },
    {
      "click": ".cm-md-table tbody tr:nth-child(3) td:first-child",
      "button": "right"
    },
    {
      "waitFor": ".kn-menu:not([aria-label]) > .kn-menu-item:has-text('Tabela')"
    },
    {
      "hover": ".kn-menu:not([aria-label]) > .kn-menu-item:has-text('Tabela')"
    },
    {
      "waitFor": "[role=menu][aria-label='Tabela']"
    },
    {
      "hover": "[aria-label='Tabela'] > .kn-menu-item:has-text('Linha')"
    },
    {
      "waitFor": "[role=menu][aria-label='Linha']"
    },
    {
      "click": "[aria-label='Linha'] > .kn-menu-item:has-text('Apagar linha')"
    },
    {
      "expectCount": ".cm-md-table tbody tr",
      "count": 3
    },
    {
      "click": ".cm-md-table th:nth-child(3)"
    },
    {
      "waitFor": ".cm-md-table-input:focus"
    },
    {
      "press": "Meta+Alt+Shift+Backspace"
    },
    {
      "expectCount": ".cm-md-table th",
      "count": 2
    },
    {
      "press": "Meta+z",
      "name": "sem nada digitado, o ⌘Z desfaz a tabela"
    },
    {
      "expectCount": ".cm-md-table th",
      "count": 3
    },
    {
      "click": ".cm-md-table th:nth-child(3)"
    },
    {
      "waitFor": ".cm-md-table-input:focus"
    },
    {
      "press": "Meta+Shift+Z"
    },
    {
      "expectCount": ".cm-md-table th",
      "count": 2
    },
    {
      "click": ".cm-md-table th:nth-child(2)"
    },
    {
      "waitFor": ".cm-md-table-input:focus"
    },
    {
      "press": "Meta+Alt+Backspace",
      "name": "apagar o cabeçalho não vale"
    },
    {
      "expectCount": ".cm-md-table th",
      "count": 2
    },
    {
      "expectCount": ".cm-md-table tbody tr",
      "count": 3
    },
    {
      "press": "Meta+Alt+Shift+ArrowUp"
    },
    {
      "type": "5"
    },
    {
      "press": "Shift+Tab"
    },
    {
      "type": "Dani"
    },
    {
      "press": "Tab"
    },
    {
      "press": "Meta+Alt+s"
    },
    {
      "press": "Escape"
    },
    {
      "expectCount": ".cm-md-table tbody tr",
      "count": 4
    },
    {
      "expectText": ".cm-md-table tbody tr:nth-child(2) td:first-child",
      "text": "Dani"
    },
    {
      "click": ".cm-md-table tbody tr:first-child td:first-child",
      "name": "Esc desfaz o que foi digitado na célula"
    },
    {
      "waitFor": ".cm-md-table-input:focus"
    },
    {
      "type": "zzz"
    },
    {
      "press": "Escape"
    },
    {
      "expectCount": ".cm-md-table td:has-text('zzz')",
      "count": 0
    },
    {
      "click": ".cm-md-table tbody tr:last-child td:first-child",
      "name": "Enter na última linha abre uma linha nova"
    },
    {
      "waitFor": ".cm-md-table-input:focus"
    },
    {
      "press": "Enter"
    },
    {
      "type": "Eva"
    },
    {
      "press": "Enter"
    },
    {
      "expectCount": ".cm-md-table tbody tr",
      "count": 6
    },
    {
      "press": "Escape"
    },
    {
      "waitFor": ".cm-md-table td:has-text('Céu | mar')"
    },
    {
      "wait": 1000
    },
    {
      "screenshot": "05-resultado.png"
    },
    {
      "click": ".cm-md-table tbody tr:first-child td:first-child",
      "button": "right"
    },
    {
      "waitFor": ".kn-menu:not([aria-label]) > .kn-menu-item:has-text('Tabela')"
    },
    {
      "hover": ".kn-menu:not([aria-label]) > .kn-menu-item:has-text('Tabela')"
    },
    {
      "waitFor": "[role=menu][aria-label='Tabela']"
    },
    {
      "click": "[aria-label='Tabela'] > .kn-menu-item:has-text('Editar como Markdown')"
    },
    {
      "waitFor": ".cm-line:has-text('| Nome')",
      "name": "o Markdown cru só pelo menu"
    },
    {
      "expectCount": ".cm-md-table",
      "count": 0
    },
    {
      "screenshot": "06-markdown.png"
    },
    {
      "click": ".cm-rendered p:has-text('Fim.')"
    },
    {
      "waitFor": ".cm-md-table",
      "name": "o cursor sai e a tabela volta"
    },
    {
      "click": ".cm-md-table td:has-text('Ana')",
      "name": "abre a célula Ana"
    },
    {
      "waitFor": ".cm-md-table-input:focus"
    },
    {
      "press": "End"
    },
    {
      "type": " Souza"
    },
    {
      "press": "Meta+k",
      "name": "a paleta tira o foco da célula (revisão #19948)"
    },
    {
      "type": "Outra nota",
      "name": "o texto vai para a busca da paleta, não para a nota"
    },
    {
      "waitFor": ".kn-palette-it:has-text('Outra nota')"
    },
    {
      "press": "Enter"
    },
    {
      "waitFor": ".cm-content:has-text('Texto da outra')",
      "name": "a outra nota abriu"
    },
    {
      "press": "Meta+k"
    },
    {
      "type": "Operações de tabela"
    },
    {
      "waitFor": ".kn-palette-it:has-text('Operações de tabela')"
    },
    {
      "press": "Enter"
    },
    {
      "waitFor": ".cm-md-table td:has-text('Ana Souza')",
      "name": "a célula ficou gravada"
    },
    {
      "expectCount": ".cm-line:has-text('Outra nota')",
      "count": 0,
      "name": "e nada do que foi digitado na paleta entrou na nota"
    },
    {
      "expectCount": ".cm-md-table tbody tr",
      "count": 6,
      "name": "nem linhas novas na tabela"
    }
  ]
}
