{
  "window": "notes",
  "steps": [
    { "invoke": "notes.create", "args": { "folder": "", "title": "Inbox", "content": "Coisas soltas. #ideia\n" } },
    { "invoke": "notes.create", "args": { "folder": "Projetos/2026/Q4", "title": "Plano", "content": "O plano do trimestre. #ideia #trabalho\n" } },
    { "invoke": "notes.create", "args": { "folder": "Arquivo", "title": "Velho", "content": "Coisa antiga.\n" } },
    { "waitFor": ".kn-crumb-bt", "name": "a janela Notas abre (antes, no cofre: Inbox na raiz, Projetos/2026/Q4/Plano e Arquivo/Velho, com tags)" },
    { "click": ".kn-crumb-bt", "name": "abre a árvore" },
    { "waitFor": ".kn-tree-pop .kn-side-new[data-all='collapse'][aria-label='Recolher todas as pastas']", "name": "o Recolher tudo no topo, junto de Nova nota e Nova pasta" },
    { "waitFor": ".kn-tree-pop .kn-side-new[data-all='expand'][aria-label='Expandir todas as pastas']", "name": "e o Expandir tudo" },
    { "expectCount": ".kn-tree-pop .kn-side-head[data-section='notes'][aria-expanded='true']", "count": 1, "name": "o padrão: tudo aberto" },
    { "expectCount": ".kn-tree-pop .kn-side-head[data-section='tags'][aria-expanded='true']", "count": 1 },
    { "expectCount": ".kn-tree-pop .kn-side-item[data-kind='folder']", "count": 2, "name": "só as pastas da raiz, fechadas" },
    { "click": ".kn-tree-pop .kn-side-new[data-all='expand']", "name": "Expandir tudo" },
    { "expectCount": ".kn-tree-pop .kn-side-item[data-kind='folder']", "count": 4, "name": "abre todas, também as de dentro (Projetos/2026/Q4)" },
    { "expectText": ".kn-tree-pop .kn-side-item[data-kind='note'][data-path='Projetos/2026/Q4/Plano.md']", "text": "Plano" },
    { "wait": 300 },
    { "screenshot": "01-tudo-aberto.png", "selector": ".kn-tree-pop" },
    { "click": ".kn-tree-pop .kn-side-new[data-all='collapse']", "name": "Recolher tudo" },
    { "expectCount": ".kn-tree-pop .kn-side-item[data-kind='folder']", "count": 2, "name": "fecha todas as pastas" },
    { "expectCount": ".kn-tree-pop .kn-side-item[data-kind='folder'][aria-expanded='true']", "count": 0 },
    { "click": ".kn-tree-pop .kn-side-head[data-section='tags']", "name": "recolhe a seção Tags pelo título" },
    { "expectCount": ".kn-tree-pop .kn-side-head[data-section='tags'][aria-expanded='false']", "count": 1 },
    { "expectCount": ".kn-tree-pop .kn-side-item[data-kind='tag']", "count": 0, "name": "fica só o título" },
    { "click": ".kn-tree-pop .kn-side-head[data-section='notes']", "name": "recolhe a seção Notas" },
    { "expectCount": ".kn-tree-pop .kn-side-item[data-kind='folder']", "count": 0 },
    { "expectCount": ".kn-tree-pop .kn-side-head[data-section='notes'][aria-expanded='false']", "count": 1 },
    { "wait": 300 },
    { "screenshot": "02-secoes-recolhidas.png", "selector": ".kn-tree-pop" },
    { "fill": ".kn-tree-pop .kn-side-search", "text": "plano", "name": "busca com a seção Notas recolhida" },
    { "waitFor": ".kn-tree-pop .kn-side-item[data-kind='note'][data-path='Projetos/2026/Q4/Plano.md']", "name": "o resultado vem inteiro" },
    { "expectText": ".kn-tree-pop .kn-side-head[data-section='notes']", "text": "Resultado" },
    { "fill": ".kn-tree-pop .kn-side-search", "text": "" },
    { "expectCount": ".kn-tree-pop .kn-side-head[data-section='notes'][aria-expanded='false']", "count": 1, "name": "sem a busca, a seção Notas volta recolhida" },
    { "click": ".kn-tree-pop .kn-side-head[data-section='tags']", "name": "abre a seção Tags de novo" },
    { "expectCount": ".kn-tree-pop .kn-side-item[data-kind='tag']", "count": 2 },
    { "press": "Escape", "name": "fecha a árvore" },
    { "click": ".kn-crumb-bt", "name": "reabre: o estado continua" },
    { "expectCount": ".kn-tree-pop .kn-side-head[data-section='notes'][aria-expanded='false']", "count": 1 },
    { "expectCount": ".kn-tree-pop .kn-side-head[data-section='tags'][aria-expanded='true']", "count": 1 },
    { "click": ".kn-tree-pop .kn-side-new[data-all='expand']", "name": "Expandir tudo abre as pastas e também a seção Notas" },
    { "expectCount": ".kn-tree-pop .kn-side-item[data-kind='folder']", "count": 4 },
    { "expectCount": ".kn-tree-pop .kn-side-head[data-section='notes'][aria-expanded='true']", "count": 1 },
    { "click": ".kn-tree-pop .kn-side-head[data-section='recent']", "name": "recolhe Recentes" },
    { "expectCount": ".kn-tree-pop .kn-side-head[data-section='recent'][aria-expanded='false']", "count": 1 },
    { "click": ".kn-tree-pop .kn-side-head[data-section='recent']", "name": "e abre de novo" },
    { "expectCount": ".kn-tree-pop .kn-side-head[data-section='recent'][aria-expanded='true']", "count": 1 }
  ]
}
