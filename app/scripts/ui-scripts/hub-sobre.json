{
  "window": "hub",
  "steps": [
    { "waitFor": ".kn-tab", "name": "o hub abre" },
    { "click": ".kn-tab:has-text('Sobre')", "name": "vai para Sobre" },
    { "expectText": ".kn-about-name", "text": "Kiwi Notes" },
    { "expectCount": ".kn-about-main img.kn-about-icon", "count": 1, "name": "o ícone à esquerda (spec #16837, mockup B)" },
    { "expectText": ".kn-about-version", "text": "Versão dev", "name": "a versão e o canal (no headless, dev)" },
    { "expectCount": ".kn-about-band[data-state=off]", "count": 1, "name": "sem o atualizador, a faixa diz que está desligado" },
    { "expectText": ".kn-about-band .kn-about-line", "text": "Atualizações desligadas" },
    { "expectCount": ".kn-about-band button", "count": 0, "name": "e não tem botão que vá à rede" },
    { "expectCount": ".kn-about-link:has-text('notas desta versão')", "count": 0, "name": "sem notas da versão num build local" },
    { "expectText": ".kn-about-foot", "text": "Tudo fica no seu Mac.", "name": "o rodapé: a privacidade numa linha" },
    { "expectCount": ".kn-about-credits", "count": 0, "name": "o textão das licenças saiu da tela" },
    { "screenshot": "hub-sobre.png" },
    { "click": ".kn-about-quiet:has-text('Licenças')", "name": "as Licenças abrem à parte" },
    { "expectText": ".kn-about-credits", "text": "PDF.js", "name": "o crédito do software de terceiros (spec #7079)" },
    { "expectText": ".kn-about-credits", "text": "da Mozilla · Apache-2.0" },
    { "expectText": ".kn-about-credits", "text": "de Michael Williamson · BSD-2-Clause" },
    { "expectText": ".kn-about-credits", "text": "de SheetJS LLC · Apache-2.0" },
    { "expectText": ".kn-about-credits", "text": "de JGraph Ltd · Apache-2.0", "name": "e o viewer do draw.io (T7112)" },
    { "screenshot": "hub-sobre-licencas.png" },
    { "click": ".kn-about-back", "name": "e voltam ao Sobre" },
    { "waitFor": ".kn-about-band" }
  ]
}
