{
  "window": "notes",
  "steps": [
    { "waitFor": ".kn-crumb-bt", "name": "a janela Notas abre (antes, no cofre: Docs/lista.txt, Docs/windows.txt em CRLF, Docs/misturado.txt com CRLF e LF, Docs/grande.txt com mais de 5 MB e uma nota)" },
    { "click": ".kn-crumb-bt", "name": "abre a árvore" },
    { "click": ".kn-tree-pop .kn-side-item[data-kind='folder']:has-text('Docs')", "name": "abre a pasta Docs" },
    { "click": ".kn-tree-pop .kn-side-item[data-kind='file']:has-text('lista')", "name": "clica no txt" },
    { "waitFor": ".kn-file[data-state='ready'] .kn-file-text-area", "name": "o txt abre nas Notas, num editor de texto" },
    { "expectText": ".kn-file-title", "text": "lista.txt", "name": "com o nome no topo" },
    { "expectCount": ".kn-file-head .kn-file-open", "count": 1, "name": "e o botão Abrir no app padrão" },
    { "expectCount": ".kn-note-editor", "count": 0, "name": "sem o editor de nota" },
    { "click": ".kn-file-text-area", "name": "o cursor vai para o texto" },
    { "press": "Meta+ArrowDown", "name": "fim do texto" },
    { "type": "quatro, ação", "name": "digita uma linha" },
    { "waitFor": ".kn-file-text-status:has-text('Gravado')", "name": "grava sozinho" },
    { "invoke": "files.read", "args": { "path": "Docs/lista.txt", "as": "text" }, "name": "o arquivo no disco tem a linha nova" },
    { "screenshot": "01-texto.png" },
    { "click": ".kn-crumb-bt", "name": "abre a árvore de novo" },
    { "click": ".kn-tree-pop .kn-side-item[data-kind='file']:has-text('windows')", "name": "clica no txt do Windows (CRLF)" },
    { "waitFor": ".kn-file[data-state='ready'] .kn-file-text-area", "name": "abre editável" },
    { "expectCount": ".kn-file-text-note", "count": 0, "name": "sem aviso de só leitura" },
    { "click": ".kn-file-text-area" },
    { "press": "Meta+ArrowDown" },
    { "type": "x", "name": "digita uma letra no fim" },
    { "waitFor": ".kn-file-text-status:has-text('Gravado')", "name": "grava" },
    { "invoke": "files.read", "args": { "path": "Docs/windows.txt", "as": "text" }, "name": "no disco, as linhas seguem em CRLF (o relatório traz o texto)" },
    { "click": ".kn-crumb-bt", "name": "abre a árvore" },
    { "click": ".kn-tree-pop .kn-side-item[data-kind='file']:has-text('misturado')", "name": "clica no txt com fins de linha misturados" },
    { "waitFor": ".kn-file-text-note", "name": "abre só para leitura, com o aviso" },
    { "expectText": ".kn-file-text-note", "text": "mistura fins de linha" },
    { "expectCount": ".kn-file-text-area[readonly]", "count": 1 },
    { "screenshot": "03-so-leitura.png" },
    { "click": ".kn-crumb-bt", "name": "abre a árvore de novo" },
    { "click": ".kn-tree-pop .kn-side-item[data-kind='file']:has-text('grande')", "name": "clica no txt de mais de 5 MB" },
    { "waitFor": ".kn-file[data-state='tooLarge'] .kn-file-notice", "name": "grande demais: o aviso com o tamanho e o app padrão" },
    { "expectText": ".kn-file-notice", "text": "até 5 MB" },
    { "screenshot": "02-grande.png" },
    { "click": ".kn-crumb-bt", "name": "abre a árvore" },
    { "click": ".kn-tree-pop .kn-side-item[data-kind='note']", "name": "clicar numa nota volta para o editor" },
    { "waitFor": ".kn-note-editor .cm-content", "name": "a nota abre" },
    { "expectCount": ".kn-file", "count": 0, "name": "e o view de arquivo sai" }
  ]
}
