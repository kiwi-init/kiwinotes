{
  "name": "kiwinotes-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kiwi Notes: local dictation and second brain for macOS (Electrobun Livewire + React).",
  "scripts": {
    "dev": "bun scripts/hutch.ts run dev",
    "dev:hmr": "bun scripts/hutch.ts run dev:hmr",
    "build": "bun scripts/hutch.ts run build",
    "prepare:eb": "bun scripts/hutch.ts electrobun prepare",
    "agent": "bun .hutch/devkit/api/sdks/main/agent/cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test src scripts ui",
    "test:dictation": "bun scripts/test-dictation.ts",
    "ui:build": "bun scripts/ui-build.ts",
    "ui:publish": "bun scripts/ui-publish.ts",
    "ui:serve": "bun scripts/ui-serve.ts",
    "notes:bench": "bun scripts/notes-bench.ts",
    "cli": "bun scripts/cli.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.6.0",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@huggingface/tokenizers": "0.2.0",
    "@joplin/turndown-plugin-gfm": "1.0.68",
    "@lezer/common": "^1.5.5",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "@orama/stemmers": "3.1.18",
    "@rive-app/canvas-single": "2.45.0",
    "katex": "0.18.10",
    "mammoth": "1.13.0",
    "mermaid": "12.2.0",
    "onnxruntime-node": "1.30.0",
    "pako": "1.0.11",
    "pdfjs-dist": "6.5.438",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-native": "file:./ui/stubs/react-native",
    "react-native-enriched-markdown": "1.1.1",
    "turndown": "7.2.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yaml": "2.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/turndown": "5.0.6",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "playwright-core": "^1.64.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  }
}
