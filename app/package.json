{
  "name": "kiwinotes-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kiwi Notes: local dictation and second brain for macOS (Electrobun Livewire + React).",
  "scripts": {
    "dev": "bun scripts/hutch.ts run dev",
    "dev:hmr": "bun scripts/hutch.ts run dev:hmr",
    "build": "bun scripts/hutch.ts run build",
    "prepare:eb": "bun scripts/hutch.ts electrobun prepare",
    "agent": "bun .hutch/devkit/api/sdks/main/agent/cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test src scripts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  }
}
