{"name": "sem termo: comprei um quiuí", "say": "comprei um quiuí", "voice": "Luciana", "expect": {"excludes": ["DICOM", "PACS", "GitHub", "Kiwi Notes", "kubectl"]}}
{"name": "sem termo: o sistema caiu de novo", "say": "o sistema caiu de novo", "voice": "Luciana", "expect": {"excludes": ["DICOM", "PACS", "GitHub", "Kiwi Notes", "kubectl"]}}
{"name": "sem termo: I get a hub of ideas", "say": "I get a hub of ideas", "voice": "Samantha", "expect": {"excludes": ["DICOM", "PACS", "GitHub", "Kiwi Notes", "kubectl"]}}
{"name": "sem termo: put the ice cube in the cup", "say": "put the ice cube in the cup", "voice": "Samantha", "expect": {"excludes": ["DICOM", "PACS", "GitHub", "Kiwi Notes", "kubectl"]}}
{"name": "sem termo: she packs her bags", "say": "she packs her bags", "voice": "Samantha", "expect": {"excludes": ["DICOM", "PACS", "GitHub", "Kiwi Notes", "kubectl"]}}
{"name": "sem termo: bring the comb", "say": "bring the comb", "voice": "Samantha", "expect": {"excludes": ["DICOM", "PACS", "GitHub", "Kiwi Notes", "kubectl"]}}
