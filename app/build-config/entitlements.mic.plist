<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- O microfone com o hardened runtime: no launcher (o processo que o TCC cobra, T658) e no kiwi-helper (que abre o
     mic). Sem isto, o mic volta mudo sem erro (#1131). -->
<plist version="1.0">
  <dict>
    <key>com.apple.security.device.audio-input</key>
    <true/>
  </dict>
</plist>
